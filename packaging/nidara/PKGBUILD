# Maintainer: Nidara Project <https://github.com/nidara-project>
#
# Nidara's own pacman package. This PKGBUILD travels INSIDE the release tag it
# builds (packaging/nidara/PKGBUILD), so the file layout below can never drift
# from the tree it packages — nidara-repo's CI fetches the tag's tarball and
# builds with the PKGBUILD found in it; install.sh uses the same recipe as its
# local fallback when the published repo lags a release.
#
# pkgver MUST equal the repo's VERSION file (bumped together in the release
# commit; CI enforces the match). The build mirrors install.sh §4 (npm + sass +
# scripts/bundle.sh × 3) and the nidara-input compile from §5; package() mirrors
# §5's file layout. First-time system/user setup (greetd, services, per-user
# config seeding) is NOT packaging's job — see install.sh / nidara-setup.
pkgname=nidara
pkgver=0.7.2
pkgrel=1
pkgdesc="Nidara — a fluid, glassmorphic desktop environment (Hyprland + GTK4/GJS)"
arch=(x86_64)
url="https://github.com/nidara-project/nidara-desktop"
license=(GPL-3.0-only)
install=nidara.install

# Runtime deps: PACMAN_DEPS from install.sh minus the build toolchain, plus the
# one pinned Astal package left in [nidara]. libastal-auth still declares
# depends=() (see packaging/README.md), so its real runtime deps must be listed
# HERE for a bare `pacman -S nidara` to pull a working system.
depends=(
  # compositor + session plumbing
  # 'hyprland>=0.56': config/hypr/hyprland.lua's `glow` block is 0.56-only (added
  # with the Assistant's focused-window glow). An older Hyprland parses the
  # session config and rejects the unknown option, so this is a hard floor, not
  # a preference — the README states the same number.
  # QUOTED, and it must stay that way: unquoted, bash reads `>` as a redirection,
  # the depends=() array never closes and the whole PKGBUILD stops sourcing.
  'hyprland>=0.56' hypridle hyprsunset uwsm greetd power-profiles-daemon polkit-gnome
  # keyring: the Secret Service (org.freedesktop.secrets) the built-in Assistant
  # stores its API key in; libsecret provides the Secret-1 typelib the shell +
  # nidara-agent import (gi://Secret)
  gnome-keyring libsecret
  # GTK/GJS runtime
  gjs gtk3 gtk4 gtk-layer-shell gtk4-layer-shell libpeas-2 wayland
  # (no libastal-* packages — all services, runtime, and PAM auth are native C/TS)
  # services the shell talks to. networkmanager is load-bearing TWICE over: the
  # daemon, and `libnm` (its dep) for the NM-1.0 typelib core/NetworkService.ts
  # imports — that typelib used to arrive via libastal-network. `upower` is now
  # load-bearing the same way: it owns UPowerGlib-1.0.typelib, which
  # core/BatteryService.ts imports.
  networkmanager bluez bluez-libs bluez-utils upower accountsservice
  pipewire pipewire-audio pipewire-alsa pipewire-pulse wireplumber libpulse
  xdg-desktop-portal-gtk xdg-desktop-portal-hyprland
  # tools the shell/keybinds shell out to
  brightnessctl pamixer playerctl jq curl slurp grim wf-recorder
  wl-clipboard cliphist wtype at-spi2-core python-gobject libnotify
  xdg-utils gsettings-desktop-schemas awww lz4 mesa pam
  # default apps wired into the UI (Super+T, Files item, calculator widget…)
  kitty nautilus gnome-calculator pavucontrol
  # fonts + icon fallbacks the design system assumes; CJK because the shell,
  # greeter and lockscreen ship zh-CN/ja catalogs AND every user sees the
  # 简体中文/日本語 endonyms in the language pickers — without it they render
  # as tofu boxes (VM sweep 2026-07-13)
  ttf-jetbrains-mono-nerd inter-font noto-fonts-emoji noto-fonts-cjk
  # adwaita-cursors = the default cursorTheme in defaults/appearance.json; listed
  # explicitly instead of relying on adwaita-icon-theme happening to depend on it
  papirus-icon-theme adwaita-icon-theme adwaita-cursors
)
# wayland-protocols + hyprland-protocols supply the XML that wayland-scanner turns
# into libnidara-wl's glue; gobject-introspection supplies g-ir-scanner, without
# which the shell's `gi://NidaraWl` import has nothing to resolve.
#
# This list is LOAD-BEARING, not documentation: nidara-repo's CI derives its whole
# build toolchain from the makedepends of the PKGBUILDs it builds — this one
# included, read straight out of the release tag — and installs nothing else
# (build-repo.sh runs makepkg --nodeps by design). Anything build() reaches for
# and this array does not name is absent in that container, which is how v0.7.0
# died on a missing hyprland-focus-grab-v1.xml. `wayland` (wayland-scanner +
# wayland-client) and `gtk4` (lib/nidara-wl/build.sh compiles and g-ir-scans
# against it) were in exactly that position: never declared, present only because
# the astal packages built before nidara happened to pull them in.
# `esbuild` is in exactly the position this comment warns about: scripts/bundle.sh
# is the bundler now, and it is the ONE thing build() reaches for that no runtime
# dep would drag in.
makedepends=(nodejs npm esbuild wlr-protocols wayland-protocols hyprland-protocols
             wayland gtk4 gobject-introspection pkgconf)
backup=(etc/xdg-desktop-portal/hyprland-portals.conf)
options=(!debug)

source=("nidara-desktop-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The tarball is fetched over TLS from the release tag and the RESULTING package
# + repo db are GPG-signed by nidara-repo's CI — same trust model as the other
# [nidara] packages (their git sources also pin by ref with SKIP sums).
sha256sums=('SKIP')

build() {
  cd "$srcdir/nidara-desktop-$pkgver"

  # Shell: SCSS → CSS, TSX → GJS bundle (mirrors install.sh §4).
  # `npm install`, not `npm ci`: the lockfile is deliberately NOT committed (see
  # the repo's .gitignore). Only sass + lucide-static resolve from the registry,
  # both build-time-only — the bundler itself is the system `esbuild`.
  cd ui/shell
  npm install
  npx sass --no-charset style.scss style.css
  sed -i '/@charset/d' style.css
  mkdir -p build
  ../../scripts/bundle.sh app.ts build/nidara

  # Greeter (reuses the shell's sass install; no npm tree of its own)
  npx sass --no-charset ../greeter/style.scss ../greeter/style.css
  sed -i '/@charset/d' ../greeter/style.css
  cd ../greeter
  mkdir -p build
  ../../scripts/bundle.sh app.ts build/nidara-greeter

  # Lockscreen (shares the greeter's style.css)
  cd ../lockscreen
  mkdir -p build
  ../../scripts/bundle.sh app.ts build/nidara-lock

  # nidara-input: zwlr_virtual_pointer_v1 client for the computer-use pointer
  # (mirrors install.sh §5 — wayland-scanner generates the protocol glue)
  cd "$srcdir/nidara-desktop-$pkgver"
  local xml=/usr/share/wlr-protocols/unstable/wlr-virtual-pointer-unstable-v1.xml
  mkdir -p build
  wayland-scanner client-header "$xml" build/wlr-virtual-pointer-unstable-v1-client-protocol.h
  wayland-scanner private-code  "$xml" build/wlr-virtual-pointer-unstable-v1-protocol.c
  cc -O2 bin/nidara-input.c build/wlr-virtual-pointer-unstable-v1-protocol.c \
     -Ibuild $(pkg-config --cflags --libs wayland-client) -o build/nidara-input

  # nidara-ipc: the D-Bus client every hyprland.lua keybind runs (mirrors
  # install.sh §5). C, not GJS — see the file's header for the 30 ms vs 2.9 ms.
  cc -O2 bin/nidara-ipc.c $(pkg-config --cflags --libs gio-2.0) -o build/nidara-ipc

  # libnidara-wl: window capture + hyprland-surface visible region, reachable
  # from GJS via introspection (mirrors install.sh §5)
  lib/nidara-wl/build.sh "$srcdir/nidara-desktop-$pkgver/build/nidara-wl"

  # libnidara-auth: PAM authentication for the lockscreen, reachable
  # from GJS via introspection (mirrors install.sh §5)
  lib/nidara-auth/build.sh "$srcdir/nidara-desktop-$pkgver/build/nidara-auth"
}

package() {
  cd "$srcdir/nidara-desktop-$pkgver"

  # PAM configuration for lockscreen
  install -Dm644 config/pam/nidara-lock "$pkgdir/etc/pam.d/nidara-lock"

  # /usr/bin — session launchers, helpers, agent toolkit (install.sh §5 list)
  local b
  for b in nidara nidara-ui nidara-greeter nidara-lock nidara-before-sleep \
           nidara-after-sleep nidara-game-mode nidara-doctor nidara-portal \
           nidara-mcp nidara-agent nidara-a11y nidara-act nidara-type nidara-click \
           nidara-update nidara-setup; do
    install -Dm755 "bin/$b" "$pkgdir/usr/bin/$b"
  done
  install -Dm755 build/nidara-input "$pkgdir/usr/bin/nidara-input"
  install -Dm755 build/nidara-ipc "$pkgdir/usr/bin/nidara-ipc"

  # libnidara-wl + its typelib. The typelib MUST land on the default
  # girepository path: the three bundles import gi://NidaraWl with no
  # GI_TYPELIB_PATH of their own, so a private location would resolve in a --dev
  # checkout and fail for every packaged install.
  install -Dm755 build/nidara-wl/libnidara-wl.so.0.0.0 \
    "$pkgdir/usr/lib/libnidara-wl.so.0.0.0"
  ln -sf libnidara-wl.so.0.0.0 "$pkgdir/usr/lib/libnidara-wl.so.0"
  ln -sf libnidara-wl.so.0     "$pkgdir/usr/lib/libnidara-wl.so"
  install -Dm644 build/nidara-wl/NidaraWl-1.0.typelib \
    "$pkgdir/usr/lib/girepository-1.0/NidaraWl-1.0.typelib"
  install -Dm644 build/nidara-wl/NidaraWl-1.0.gir \
    "$pkgdir/usr/share/gir-1.0/NidaraWl-1.0.gir"

  # libnidara-auth + its typelib (PAM authentication for the lockscreen)
  install -Dm755 build/nidara-auth/libnidara-auth.so.0.0.0 \
    "$pkgdir/usr/lib/libnidara-auth.so.0.0.0"
  ln -sf libnidara-auth.so.0.0.0 "$pkgdir/usr/lib/libnidara-auth.so.0"
  ln -sf libnidara-auth.so.0     "$pkgdir/usr/lib/libnidara-auth.so"
  install -Dm644 build/nidara-auth/NidaraAuth-1.0.typelib \
    "$pkgdir/usr/lib/girepository-1.0/NidaraAuth-1.0.typelib"
  install -Dm644 build/nidara-auth/NidaraAuth-1.0.gir \
    "$pkgdir/usr/share/gir-1.0/NidaraAuth-1.0.gir"

  # /usr/share/nidara — bundles, styles, assets, shared config
  install -Dm644 VERSION "$pkgdir/usr/share/nidara/VERSION"
  install -Dm644 defaults/wallpaper/wallpaper.jpg "$pkgdir/usr/share/nidara/wallpaper.jpg"
  install -Dm755 ui/shell/build/nidara "$pkgdir/usr/share/nidara/ui/shell/build/nidara"
  install -Dm644 ui/shell/style.css "$pkgdir/usr/share/nidara/ui/shell/style.css"
  cp -r ui/shell/assets "$pkgdir/usr/share/nidara/ui/shell/assets"
  install -Dm755 ui/greeter/build/nidara-greeter "$pkgdir/usr/share/nidara/ui/greeter/build/nidara-greeter"
  install -Dm644 ui/greeter/style.css "$pkgdir/usr/share/nidara/ui/greeter/style.css"
  install -Dm755 ui/lockscreen/build/nidara-lock "$pkgdir/usr/share/nidara/ui/lockscreen/build/nidara-lock"

  # Shared Hyprland config (the session loads it via -c, see bin/nidara)
  mkdir -p "$pkgdir/usr/share/nidara/config"
  cp -r config/hypr "$pkgdir/usr/share/nidara/config/hypr"

  # Payloads consumed by first-time setup (greetd templates, per-user seeds).
  # The wallpaper already ships at its canonical path above — don't duplicate it.
  cp -r config/greetd "$pkgdir/usr/share/nidara/config/greetd"
  cp -r defaults "$pkgdir/usr/share/nidara/defaults"
  rm -rf "$pkgdir/usr/share/nidara/defaults/wallpaper"

  # Assistant skills — markdown playbooks bin/nidara-agent loads on demand. This
  # is the path a PACKAGE install takes, and it is the one that matters most: a
  # --dev checkout reads the repo's skills/ directly, so forgetting this line
  # would leave load_skill quietly absent for every real user while working
  # perfectly on the maintainer's machine.
  cp -r skills "$pkgdir/usr/share/nidara/skills"

  # Greeter's blank GTK4 theme (GTK_THEME=nidara → zero theme rules; GTK falls
  # back to Adwaita silently if this file is missing — a real past bite)
  install -Dm644 ui/greeter/theme/gtk.css "$pkgdir/usr/share/themes/nidara/gtk-4.0/gtk.css"

  # Session entry + app entries
  install -Dm644 config/wayland-sessions/nidara.desktop "$pkgdir/usr/share/wayland-sessions/nidara.desktop"
  mkdir -p "$pkgdir/usr/share/applications"
  install -m644 config/applications/*.desktop "$pkgdir/usr/share/applications/"

  # systemd user unit (started by the Nidara Hyprland config, never enabled —
  # see the unit's NOTE)
  install -Dm644 bin/nidara.service "$pkgdir/usr/lib/systemd/user/nidara.service"

  # XDG portal: Nidara's Settings backend (accent-color) + portal preferences
  install -Dm644 config/portal/nidara.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/nidara.portal"
  install -Dm644 config/portal/org.freedesktop.impl.portal.desktop.nidara.service \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.nidara.service"
  install -Dm644 config/portal/hyprland-portals.conf "$pkgdir/etc/xdg-desktop-portal/hyprland-portals.conf"

  # fontconfig: per-language CJK variant — the 65-0- filename MUST sort before
  # fontconfig's 65-nonlatin.conf (see the file's header comment)
  install -Dm644 config/fontconfig/65-0-nidara-noto-cjk.conf \
    "$pkgdir/usr/share/fontconfig/conf.avail/65-0-nidara-noto-cjk.conf"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.avail/65-0-nidara-noto-cjk.conf \
    "$pkgdir/etc/fonts/conf.d/65-0-nidara-noto-cjk.conf"
}
