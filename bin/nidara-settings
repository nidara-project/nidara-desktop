#!/usr/bin/env bash
# Current public entry: share the GJS launcher while retaining its original bus identity.
set -euo pipefail
export NIDARA_SETTINGS_PROCESS=1 GDK_BACKEND=wayland
if [ -n "${NIDARA_SETTINGS_EXECUTABLE:-}" ]; then
    exec "$NIDARA_SETTINGS_EXECUTABLE" "$@"
fi
export NIDARA_SETTINGS_LEGACY=0
exec "$(dirname -- "$0")/nidara-settings-legacy" "$@"
