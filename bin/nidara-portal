const interfaceSettings = new Gio.Settings({ schema_id: "org.gnome.desktop.interface" })
let a11ySettings = null
try {
    a11ySettings = new Gio.Settings({ schema_id: "org.gnome.desktop.a11y.interface" })
} catch (_) {}

function getUserAvatarUri() {
    const home = GLib.get_home_dir()
    const username = GLib.get_user_name()
    const candidates = [
        `${home}/.face`,
        `${home}/.face.icon`,
        `/var/lib/AccountsService/icons/${username}`,
        `${GLib.get_user_data_dir()}/nidara/avatar.png`,
    ]
    for (const candidate of candidates) {
        if (GLib.file_test(candidate, GLib.FileTest.EXISTS)) {
            return GLib.filename_to_uri(candidate, null) || `file://${candidate}`
        }
    }
    return ""
}

function getUserDisplayName() {
    const realName = GLib.get_real_name()
    if (realName && realName !== "Unknown" && realName.trim().length > 0) {
        return realName
    }
    return GLib.get_user_name()
}

function accentRgbVariant() {
    const name = interfaceSettings.get_string("accent-color")
    const hex = ACCENT_HEX[name] ?? ACCENT_HEX.blue
    const r = parseInt(hex.slice(1, 3), 16) / 255
    const g = parseInt(hex.slice(3, 5), 16) / 255
    const b = parseInt(hex.slice(5, 7), 16) / 255
    return new GLib.Variant("(ddd)", [r, g, b])
}

function colorSchemeVariant() {
    // 0: no preference, 1: prefer-dark, 2: prefer-light
    //
    // ⚠️ THE ENUM HAS THREE VALUES, NOT TWO. `gsettings range` gives
    // `default | prefer-dark | prefer-light`, and this used to read
    // `scheme === "prefer-light" ? 2 : 1` — which reported `default` as "prefer
    // DARK" to every app that asked. Nidara now seeds `prefer-light` explicitly
    // (defaults/appearance.json → the system dconf default), so the bad branch is
    // rarely reached on our own installs; it was wrong for everyone else.
    const scheme = interfaceSettings.get_string("color-scheme")
    const val = scheme === "prefer-light" ? 2 : scheme === "prefer-dark" ? 1 : 0
    return new GLib.Variant("u", val)
}

/**
 * org.nidara.appearance, or null when the schema is not installed — a broken
 * install, where the namespace answers with the shipped defaults instead of taking
 * the daemon down (`new Gio.Settings` on a missing schema throws).
 */
let nidaraSettings = null
try {
    const schema = Gio.SettingsSchemaSource.get_default()?.lookup(NIDARA_NS, true)
    if (schema) nidaraSettings = new Gio.Settings({ settings_schema: schema })
    else printerr(`[nidara-portal] schema ${NIDARA_NS} is not installed — serving its defaults`)
} catch (e) {
    printerr(`[nidara-portal] cannot open ${NIDARA_NS}: ${e}`)
}

const NIDARA_DEFAULTS = {
    "window-opacity": new GLib.Variant("d", 0.48),
    "bar-opacity": new GLib.Variant("d", 0.48),
    "overlay-opacity": new GLib.Variant("d", 0.48),
    "dock-opacity": new GLib.Variant("d", 0.24),
    "shell-appearance": new GLib.Variant("s", "system"),
}

/**
 * Our namespace's payload. Kebab-case keys, like every other portal namespace, and
 * the SAME names as the schema's keys, so this is a straight read.
 *
 * Only what a SECOND process needs to look like Nidara. The icon/cursor/font
 * settings already reach apps through `org.gnome.desktop.interface`, and
 * duplicating them here would create a second answer to a question that already
 * has one.
 */
function nidaraKeys() {
    const out = {}
    for (const key of NIDARA_KEYS)
        out[key] = nidaraSettings ? nidaraSettings.get_value(key) : NIDARA_DEFAULTS[key]
    return out
}


function contrastVariant() {
    // 0: no preference, 1: high contrast
    let val = 0
    if (a11ySettings) {
        try {
            if (a11ySettings.get_boolean("high-contrast")) val = 1
        } catch (_) {}
    }
    return new GLib.Variant("u", val)
}

function reducedMotionVariant() {
    // 0: no preference (animations on), 1: reduced motion (animations off)
    let val = 0
    if (interfaceSettings) {
        try {
            if (!interfaceSettings.get_boolean("enable-animations")) val = 1
        } catch (_) {}
    }
    return new GLib.Variant("u", val)
}

/**
 * Does this ReadAll's namespace list ask for `ns`?
 *
 * An empty list (or an empty pattern in it) means "everything", per the portal
 * spec — and the patterns are glob-style, so `org.freedesktop.*` has to match.
 */
function nsMatches(patterns, ns) {
    if (!patterns || patterns.length === 0) return true
    return patterns.some(p => p === "" || GLib.pattern_match_simple(p, ns))
}

function decodeUriToPath(uri) {
    if (!uri) return null
    if (uri.startsWith("file://")) {
        try {
            const [path] = GLib.filename_from_uri(uri)
            return path
        } catch (_) {
            return decodeURIComponent(uri.replace(/^file:\/\//, ""))
        }
    }
    if (uri.startsWith("/")) return uri
    return null
}

function applyWallpaperFallback(path) {
    const configDir = `${GLib.get_user_config_dir()}/nidara`
    GLib.mkdir_with_parents(configDir, 0o755)
    const cfgPath = `${configDir}/wallpaper`
    let cfg = {}
    try {
        const [ok, contents] = GLib.file_get_contents(cfgPath)
        if (ok) cfg = JSON.parse(new TextDecoder().decode(contents))
    } catch (_) {}
    cfg.path = path
    cfg.transition = cfg.transition || "random"
    GLib.file_set_contents(cfgPath, JSON.stringify(cfg))
    // ⚠️ ARGV, NOT A COMMAND STRING. `path` arrives inside a URI handed over by ANY
    // app that calls the Wallpaper portal, and `cfg.transition` is read back out of a
    // JSON file on disk. Interpolating either into a string and letting
    // `spawn_command_line_async` split it means a filename containing a quote injects
    // extra arguments into awww. (It is argument injection rather than command
    // execution — `g_shell_parse_argv` does not run a shell — but the fix is the same
    // and it is the rule the computer-use helpers already follow: fixed argv, never a
    // shell.)
    try {
        Gio.Subprocess.new(
            ["awww", "img", path, "--transition-type", String(cfg.transition)],
            Gio.SubprocessFlags.NONE,
        )
    } catch (e) {
        printerr(`[nidara-portal] awww fallback failed: ${e}`)
    }
}

/**
 * Every key of `org.gnome.desktop.interface`, as the portal's `a{sv}`. Enumerated
 * from the schema, so a key added by a future GLib arrives on its own.
 */
function gnomeKeys() {
    const out = {}
    try {
        for (const key of interfaceSettings.settings_schema.list_keys()) {
            out[key] = interfaceSettings.get_value(key)
        }
    } catch (e) {
        printerr(`[nidara-portal] cannot enumerate ${GNOME_NS}: ${e}`)
    }
    return out
}

// ── Settings Backend ─────────────────────────────────────────────────────────
class SettingsBackend {
    get version() { return 1 }

    ReadAllAsync(params, invocation) {
        const [namespaces] = params
        const dict = {}
        if (nsMatches(namespaces, APPEARANCE_NS)) {
            dict[APPEARANCE_NS] = {
                "accent-color": accentRgbVariant(),
                "color-scheme": colorSchemeVariant(),
                "contrast": contrastVariant(),
                "reduced-motion": reducedMotionVariant(),
            }
        }
        if (nsMatches(namespaces, GNOME_NS)) dict[GNOME_NS] = gnomeKeys()
        if (nsMatches(namespaces, NIDARA_NS)) dict[NIDARA_NS] = nidaraKeys()
        invocation.return_value(new GLib.Variant("(a{sa{sv}})", [dict]))
    }

    ReadAsync(params, invocation) {
        const [namespace, key] = params
        if (namespace === APPEARANCE_NS) {
            if (key === "accent-color") {
                invocation.return_value(new GLib.Variant("(v)", [accentRgbVariant()]))
                return
            }
            if (key === "color-scheme") {
                invocation.return_value(new GLib.Variant("(v)", [colorSchemeVariant()]))
                return
            }
            if (key === "contrast") {
                invocation.return_value(new GLib.Variant("(v)", [contrastVariant()]))
                return
            }
            if (key === "reduced-motion") {
                invocation.return_value(new GLib.Variant("(v)", [reducedMotionVariant()]))
                return
            }
        }
        if (namespace === NIDARA_NS) {
            const keys = nidaraKeys()
            if (keys[key]) {
                invocation.return_value(new GLib.Variant("(v)", [keys[key]]))
                return
            }
        }
        if (namespace === GNOME_NS) {
            const keys = gnomeKeys()
            if (keys[key]) {
                invocation.return_value(new GLib.Variant("(v)", [keys[key]]))
                return
            }
        }
        // Nothing to fall through to: portals.conf names us alone for Settings.
        invocation.return_dbus_error(
            "org.freedesktop.portal.Error.NotFound",
            `nidara-portal does not serve ${namespace} ${key}`,
        )
    }
}

// ── Access Backend ───────────────────────────────────────────────────────────
class AccessBackend {
    AccessDialogAsync(params, invocation) {
        const handle = params[0]
        const connection = invocation.get_connection()
        const raw = invocation.get_parameters()

        // Forward the request as the frontend sent it — every argument untouched,
        // except the handle, which crosses to the shell as a plain string (it is a
        // key there, not an object on its bus).
        const forwarded = GLib.Variant.new_tuple([
            new GLib.Variant("s", handle),
            ...[1, 2, 3, 4, 5, 6].map(i => raw.get_child_value(i)),
        ])

        let finished = false
        let request = null
        const finish = (response, results) => {
            if (finished) return
            finished = true
            if (request) { try { request.unexport() } catch (_) {} request = null }
            // `results` arrives as a GLib.Variant (a{sv}) — packed as a tuple CHILD, not
            // re-packed: `new GLib.Variant("(ua{sv})", [r, variant])` throws inside this
            // callback, the invocation is never answered, and the app hangs until its
            // D-Bus timeout. Caught by scripts/dev/consent-portal-probe.sh.
            try {
                invocation.return_value(GLib.Variant.new_tuple([new GLib.Variant("u", response), results]))
            } catch (e) {
                printerr(`[nidara-portal] could not answer AccessDialog: ${e}`)
                invocation.return_dbus_error("org.freedesktop.portal.Error.Failed", String(e))
            }
        }

        try {
            request = Gio.DBusExportedObject.wrapJSObject(REQUEST_IFACE_XML, {
                CloseAsync(_params, inv) {
                    // Dismiss the prompt; the shell answers the pending AccessDialog
                    // as denied, which reaches `finish` below.
                    Gio.DBus.session.call(SHELL_BUS, CONSENT_PATH, CONSENT_IFACE, "Close",
                        new GLib.Variant("(s)", [handle]), null, Gio.DBusCallFlags.NONE, 5000, null, () => {})
                    inv.return_value(null)
                },
            })
            request.export(connection, handle)
        } catch (e) {
            printerr(`[nidara-portal] could not export Request at ${handle}: ${e}`)
            request = null
        }

        Gio.DBus.session.call(
            SHELL_BUS, CONSENT_PATH, CONSENT_IFACE, "AccessDialog", forwarded,
            new GLib.VariantType("(ua{sv})"), Gio.DBusCallFlags.NONE,
            // A person is answering: no timeout. The app's own Close ends it early.
            GLib.MAXINT32, null,
            (bus, res) => {
                try {
                    const reply = bus.call_finish(res)
                    finish(reply.get_child_value(0).get_uint32(), reply.get_child_value(1))
                } catch (e) {
                    printerr(`[nidara-portal] consent prompt failed, answering denied: ${e}`)
                    finish(RESPONSE_OTHER, new GLib.Variant("a{sv}", {}))
                }
            },
        )
    }
}

// ── Wallpaper Backend ────────────────────────────────────────────────────────
class WallpaperBackend {
    SetWallpaperURIAsync(params, invocation) {
        const [, appId, , uri] = params
        print(`[nidara-portal] SetWallpaperURI requested by ${appId || "unknown"}: ${uri}`)

        const srcPath = decodeUriToPath(uri)
        if (!srcPath || !GLib.file_test(srcPath, GLib.FileTest.EXISTS)) {
            printerr(`[nidara-portal] Wallpaper file does not exist: ${srcPath}`)
            // Response 2 = Failed
            invocation.return_value(new GLib.Variant("(u)", [2]))
            return
        }

        let targetPath = srcPath
        // If image is in a temporary or sandbox location (/tmp, /run/user/..., /doc/),
        // copy it to user's persistent wallpapers folder so it persists after the app closes.
        if (srcPath.startsWith("/tmp/") || srcPath.startsWith("/run/user/") || srcPath.includes("/doc/")) {
            const wallDir = `${GLib.get_user_data_dir()}/nidara/wallpapers`
            GLib.mkdir_with_parents(wallDir, 0o755)
            const baseName = GLib.path_get_basename(srcPath)
            const destPath = `${wallDir}/${Date.now()}_${baseName}`
            try {
                const srcFile = Gio.File.new_for_path(srcPath)
                const destFile = Gio.File.new_for_path(destPath)
                srcFile.copy(destFile, Gio.FileCopyFlags.OVERWRITE, null, null)
                targetPath = destPath
                print(`[nidara-portal] Cached temporary wallpaper to: ${targetPath}`)
            } catch (e) {
                printerr(`[nidara-portal] Failed to copy temporary wallpaper: ${e}`)
            }
        }

        // Apply wallpaper via nidara-ipc (if shell running) or fallback
        // Same argv rule as the fallback below — `targetPath` is caller-supplied.
        try {
            const proc = Gio.Subprocess.new(
                ["nidara-ipc", "setWallpaper", targetPath],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait(null)
            if (!proc.get_successful()) {
                applyWallpaperFallback(targetPath)
            }
        } catch (_) {
            applyWallpaperFallback(targetPath)
        }

        // Response 0 = Success
        invocation.return_value(new GLib.Variant("(u)", [0]))
    }
}

// ── Dynamic Launcher Backend ────────────────────────────────────────────────
class DynamicLauncherBackend {
    get version() { return 1 }
    get SupportedLauncherTypes() { return 3 } // 1 (App) + 2 (Webapp)

    PrepareInstallAsync(params, invocation) {
        const [, appId, , name, iconVariant] = params
        print(`[nidara-portal] PrepareInstall requested for "${name}" by ${appId || "unknown"}`)

        // Return 0 (Success) with the chosen name and icon for xdg-desktop-portal to install
        const results = {
            name: new GLib.Variant("s", name || "Web App"),
            icon: iconVariant,
        }
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }

    RequestInstallTokenAsync(params, invocation) {
        const [appId] = params
        print(`[nidara-portal] RequestInstallToken requested by ${appId || "unknown"}`)
        // Response 0 = Allowed
        invocation.return_value(new GLib.Variant("(u)", [0]))
    }
}

// ── Account Backend ─────────────────────────────────────────────────────────
class AccountBackend {
    get version() { return 1 }

    GetUserInformationAsync(params, invocation) {
        const [, appId] = params
        const username = GLib.get_user_name()
        const realName = getUserDisplayName()
        const imageUri = getUserAvatarUri()

        print(`[nidara-portal] GetUserInformation requested by ${appId || "unknown"} for ${username} ("${realName}")`)

        const results = {
            id: new GLib.Variant("s", username),
            name: new GLib.Variant("s", realName),
        }
        if (imageUri) {
            results.image = new GLib.Variant("s", imageUri)
        }

        // Response 0 = Success
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }
}

// ── Background Backend ──────────────────────────────────────────────────────
class BackgroundBackend {
    GetAppStateAsync(params, invocation) {
        // Return mapping of app states (0=Background, 1=Running, 2=Active)
        invocation.return_value(new GLib.Variant("(a{sv})", [{}]))
    }

    NotifyBackgroundAsync(params, invocation) {
        const [, appId, name] = params
        print(`[nidara-portal] NotifyBackground requested for "${name || appId || "unknown"}"`)
        // 1 = Allow background activity
        const results = {
            result: new GLib.Variant("u", 1),
        }
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }

    EnableAutostartAsync(params, invocation) {
        const [appId, enable, commandline] = params
        print(`[nidara-portal] EnableAutostart requested for ${appId}: ${enable}`)
        const autostartDir = `${GLib.get_user_config_dir()}/autostart`
        GLib.mkdir_with_parents(autostartDir, 0o755)
        const desktopPath = `${autostartDir}/${appId}.desktop`

        if (enable) {
            const exec = (commandline && commandline.length > 0) ? commandline.join(" ") : appId
            const content = `[Desktop Entry]\nType=Application\nName=${appId}\nExec=${exec}\nX-GNOME-Autostart-enabled=true\n`
            GLib.file_set_contents(desktopPath, content)
        } else {
            if (GLib.file_test(desktopPath, GLib.FileTest.EXISTS)) {
                try {
                    Gio.File.new_for_path(desktopPath).delete(null)
                } catch (_) {}
            }
        }
        invocation.return_value(new GLib.Variant("(b)", [true]))
    }
}


const loop = new GLib.MainLoop(null, false)
const settingsBackend = new SettingsBackend()
const accessBackend = new AccessBackend()
const wallpaperBackend = new WallpaperBackend()
const dynamicLauncherBackend = new DynamicLauncherBackend()
const accountBackend = new AccountBackend()
const backgroundBackend = new BackgroundBackend()

const exportedSettings = Gio.DBusExportedObject.wrapJSObject(SETTINGS_IFACE_XML, settingsBackend)
const exportedAccess = Gio.DBusExportedObject.wrapJSObject(ACCESS_IFACE_XML, accessBackend)
const exportedWallpaper = Gio.DBusExportedObject.wrapJSObject(WALLPAPER_IFACE_XML, wallpaperBackend)
const exportedDynamicLauncher = Gio.DBusExportedObject.wrapJSObject(DYNAMIC_LAUNCHER_IFACE_XML, dynamicLauncherBackend)
const exportedAccount = Gio.DBusExportedObject.wrapJSObject(ACCOUNT_IFACE_XML, accountBackend)
const exportedBackground = Gio.DBusExportedObject.wrapJSObject(BACKGROUND_IFACE_XML, backgroundBackend)

Gio.bus_own_name(
    Gio.BusType.SESSION,
    BUS_NAME,
    Gio.BusNameOwnerFlags.NONE,
    (connection) => {
        exportedSettings.export(connection, OBJECT_PATH)
        exportedAccess.export(connection, OBJECT_PATH)
        exportedWallpaper.export(connection, OBJECT_PATH)
        exportedDynamicLauncher.export(connection, OBJECT_PATH)
        exportedAccount.export(connection, OBJECT_PATH)
        exportedBackground.export(connection, OBJECT_PATH)

        // Live appearance updates
        interfaceSettings.connect("changed::accent-color", () => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [APPEARANCE_NS, "accent-color", accentRgbVariant()]),
            )
        })

        // Every key of the GNOME namespace, announced under its own name. This is a
        // SECOND signal for `color-scheme` and `accent-color` — deliberately: those two
        // are announced under `org.freedesktop.appearance` as well, with different names
        // and different types, and a client subscribes to one namespace or the other.
        interfaceSettings.connect("changed", (_s, key) => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [GNOME_NS, key, interfaceSettings.get_value(key)]),
            )
        })

        interfaceSettings.connect("changed::color-scheme", () => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [APPEARANCE_NS, "color-scheme", colorSchemeVariant()]),
            )
        })

        if (a11ySettings) {
            a11ySettings.connect("changed::high-contrast", () => {
                exportedSettings.emit_signal(
                    "SettingChanged",
                    new GLib.Variant("(ssv)", [APPEARANCE_NS, "contrast", contrastVariant()]),
                )
            })
        }

        interfaceSettings.connect("changed::enable-animations", () => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [APPEARANCE_NS, "reduced-motion", reducedMotionVariant()]),
            )
        })

        // Our namespace: one `changed::<key>` per key that actually moved. dconf
        // emits nothing for a value written equal to the stored one, and ThemeManager
        // writes once per slider GESTURE, so a listener is not asked to rebuild its
        // stylesheet on every frame of a drag.
        if (nidaraSettings) {
            nidaraSettings.connect("changed", (_s, key) => {
                if (!NIDARA_KEYS.includes(key)) return
                exportedSettings.emit_signal(
                    "SettingChanged",
                    new GLib.Variant("(ssv)", [NIDARA_NS, key, nidaraSettings.get_value(key)]),
                )
            })
        }

        print(`[nidara-portal] serving Settings + Wallpaper + Access (+ unrouted DynamicLauncher, Account, Background) on ${BUS_NAME}`)
    },
    null,
    () => {
        printerr(`[nidara-portal] lost/failed bus name ${BUS_NAME} — exiting`)
        loop.quit()
    },
)

loop.run()
