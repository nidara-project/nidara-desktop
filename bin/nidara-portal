#!/usr/bin/env -S gjs -m
// ─────────────────────────────────────────────────────────────────────────────
// nidara-portal — Nidara's xdg-desktop-portal Settings, Wallpaper & Access backend
// Installed to /usr/bin/nidara-portal, D-Bus-activated as
// org.freedesktop.impl.portal.desktop.nidara (see the .portal + .service
// files installed by install.sh).
//
// WHY THIS EXISTS:
// 1. Under Hyprland no standard portal backend serves `org.freedesktop.appearance
//    accent-color`, so libadwaita/GNOME apps stay on their default blue.
//    This daemon serves the complete `org.freedesktop.appearance` namespace
//    (accent-color, color-scheme, contrast, reduced-motion) and Nidara's own
//    `org.nidara.appearance` extension.
//
//    🔑 THE CONTRACT (#534 — the full text is in ui/lib/appearance.ts): every
//    setting has ONE home, and this daemon is how APPLICATIONS reach it. GTK 4.22
//    reads color-scheme/contrast/reduced-motion from here by itself; libadwaita
//    reads the accent; our own installer, lock screen and any Nidara app read BOTH
//    namespaces from here and from nowhere else. So a key served here must never
//    also be served under a second name — a client that can read one value two
//    ways will, sooner or later, read two different values.
// 2. Under Hyprland no portal backend implements `org.freedesktop.impl.portal.Wallpaper`,
//    so "Set as Desktop Background" in browsers (Firefox, Chrome) and image viewers
//    fails. This daemon implements SetWallpaperURI to apply and persist wallpapers.
//
// ⚠️ THREE BACKENDS BELOW ARE IMPLEMENTED BUT NOT ROUTED (2026-08-24):
// Account, DynamicLauncher and Background. They are still exported on the bus, but
// `config/portal/nidara.portal` no longer advertises those interfaces and
// `hyprland-portals.conf` no longer names us for them, so xdg-desktop-portal does
// not send them here.
//
// WHY: all three GRANT WITHOUT ASKING. `GetUserInformation` hands the real name and
// avatar to any caller; `PrepareInstall` / `RequestInstallToken` approve a launcher
// with the caller's own name and icon unreviewed; `NotifyBackground` always answers
// "allow". An `impl.portal` backend IS the place where the desktop asks the user —
// one that says yes to everything has implemented the interface and deleted the
// policy. And for Account and DynamicLauncher it was a REGRESSION, not a gap:
// `gtk.portal` declares both and shows a real dialog.
//
// The code is kept, not deleted, because the shape is right and only the consent
// step is missing. Read tech-debt #89 before re-routing any of them: it says what
// "asks" has to mean, and it is more than showing a dialog.
// ─────────────────────────────────────────────────────────────────────────────

import Gio from "gi://Gio"
import GLib from "gi://GLib"

// KEEP IN SYNC with ui/lib/accent.ts ACCENT_HEX (single source of truth for
// the palette). Duplicated here because this daemon is a standalone GJS
// script with no access to the TS bundles.
const ACCENT_HEX = {
    blue:   "#0088FF",
    teal:   "#2190a4",
    green:  "#79B757",
    yellow: "#F3BA4B",
    orange: "#E9873A",
    red:    "#ED5F5D",
    pink:   "#E55E9C",
    purple: "#9A57A3",
    slate:  "#6f8396",
}

const APPEARANCE_NS = "org.freedesktop.appearance"

// ── Our own namespace ────────────────────────────────────────────────────────
// `org.freedesktop.appearance` is a FOUR-KEY spec: accent, colour scheme,
// contrast, reduced motion. It is the right channel for those and the reason
// third-party GTK apps follow Nidara's accent at all — but it has no room for the
// desktop's own vocabulary (the glass opacities). Its accent is an (r,g,b) triple;
// a client that wants a palette KEY maps it to the nearest entry, exactly as
// libadwaita does, and from this backend the match is exact.
//
// So Nidara serves a second namespace beside it. The Settings portal's ReadAll
// takes a LIST of namespaces and merges what every impl backend answers, so a
// caller asks for both in one round trip and gets one dictionary back. That is
// what makes this worth doing instead of every bundle opening the file itself:
// one read, one `SettingChanged` signal, and it crosses a sandbox boundary — a
// Flatpak app cannot read the user's dconf and can see this.
//
// ⚠️ ONLY the keys that have no standard home. The accent and the dark/light mode
// are NOT here: they live in `org.gnome.desktop.interface` and reach clients as
// `org.freedesktop.appearance` above. #533 served them under both names (`accent`,
// `is-dark`), and the day the two disagreed nobody could say which one was true.
//
// The home of these keys is GSettings `org.nidara.appearance` (#573) — same key
// names as this namespace, written by `ThemeManager` or by anybody with `gsettings`.
// This daemon runs in the user's session and reads THAT only — `/var/tmp/nidara/
// appearance.json` is the greeter's mirror, an export for a surface outside any
// session, and nothing in a session reads it back.
const NIDARA_NS = "org.nidara.appearance"

/**
 * The GNOME interface namespace — `gtk-theme`, `icon-theme`, `font-name`,
 * `cursor-theme`, `cursor-size`, `color-scheme`… — served here since 2026-09-20.
 *
 * ⚠️ It used to be `xdg-desktop-portal-gtk`'s job, and that is exactly why the bus
 * carried TWO `SettingChanged` for every mode change: `portals.conf` listed
 * `Settings=nidara;gtk`, the gtk backend was there for THIS namespace, and both of
 * us also served `org.freedesktop.appearance color-scheme`. A client that can read
 * one value two ways eventually reads two different values — which is the appearance
 * contract's own rule (#534), broken by our own routing.
 *
 * So we serve all three namespaces and `portals.conf` names only us. The keys are
 * enumerated from the SCHEMA rather than listed here: a hand-written list is a list
 * of what somebody remembered, and a key we forget is a setting that silently stops
 * reaching every GTK3, Qt and Chromium application on the desktop.
 */
const GNOME_NS = "org.gnome.desktop.interface"
const NIDARA_KEYS = ["window-opacity", "bar-opacity", "overlay-opacity", "dock-opacity", "shell-appearance"]
const BUS_NAME = "org.freedesktop.impl.portal.desktop.nidara"
const OBJECT_PATH = "/org/freedesktop/portal/desktop"

const SETTINGS_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Settings">
    <property name="version" type="u" access="read"/>
    <method name="ReadAll">
      <arg type="as" name="namespaces" direction="in"/>
      <arg type="a{sa{sv}}" name="value" direction="out"/>
    </method>
    <method name="Read">
      <arg type="s" name="namespace" direction="in"/>
      <arg type="s" name="key" direction="in"/>
      <arg type="v" name="value" direction="out"/>
    </method>
    <signal name="SettingChanged">
      <arg type="s" name="namespace"/>
      <arg type="s" name="key"/>
      <arg type="v" name="value"/>
    </signal>
  </interface>
</node>`

// ── Access: consent prompts, DRAWN BY THE SHELL ──────────────────────────────
// This script has no GTK, and a consent prompt has to look like the desktop and
// speak its languages — so the prompt is forwarded to the shell's
// `org.nidara.Shell.Consent` (ui/shell/surfaces/consent/ConsentService.ts), which
// only answers this process. Remembering the answer is xdg-desktop-portal's own job
// (it reads the PermissionStore before calling us and writes after).
// 🔴 Never grants by default: shell missing, shell error, app closing the request —
// every path that is not the user pressing Allow answers "denied" (tech-debt #89).
const ACCESS_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Access">
    <method name="AccessDialog">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="title" direction="in"/>
      <arg type="s" name="subtitle" direction="in"/>
      <arg type="s" name="body" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
  </interface>
</node>`

// The object a BACKEND exports at `handle` while a request is pending: the frontend
// calls its `Close` when the app gives up waiting, and the prompt must go away.
const REQUEST_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Request">
    <method name="Close"/>
  </interface>
</node>`

const SHELL_BUS = "org.nidara.Shell"
const CONSENT_PATH = "/org/nidara/Shell/Consent"
const CONSENT_IFACE = "org.nidara.Shell.Consent"
// Portal response codes: 0 success, 1 cancelled by the user, 2 other/failed.
const RESPONSE_OTHER = 2

const WALLPAPER_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Wallpaper">
    <method name="SetWallpaperURI">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="uri" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
    </method>
  </interface>
</node>`

const DYNAMIC_LAUNCHER_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.DynamicLauncher">
    <property name="version" type="u" access="read"/>
    <property name="SupportedLauncherTypes" type="u" access="read"/>
    <method name="PrepareInstall">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="v" name="icon_v" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
    <method name="RequestInstallToken">
      <arg type="s" name="app_id" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
    </method>
  </interface>
</node>`

const ACCOUNT_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Account">
    <property name="version" type="u" access="read"/>
    <method name="GetUserInformation">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
  </interface>
</node>`

const BACKGROUND_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Background">
    <method name="GetAppState">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="apps" direction="out"/>
    </method>
    <method name="NotifyBackground">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
    <method name="EnableAutostart">
      <arg type="s" name="app_id" direction="in"/>
      <arg type="b" name="enable" direction="in"/>
      <arg type="as" name="commandline" direction="in"/>
      <arg type="u" name="flags" direction="in"/>
      <arg type="b" name="result" direction="out"/>
    </method>
    <signal name="RunningApplicationsChanged">
    </signal>
  </interface>
