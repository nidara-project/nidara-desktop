#!/usr/bin/env -S gjs -m
// ─────────────────────────────────────────────────────────────────────────────
// nidara-portal — Nidara's xdg-desktop-portal Settings & Wallpaper backend
// Installed to /usr/bin/nidara-portal, D-Bus-activated as
// org.freedesktop.impl.portal.desktop.nidara (see the .portal + .service
// files installed by install.sh).
//
// WHY THIS EXISTS:
// 1. Under Hyprland no standard portal backend serves `org.freedesktop.appearance
//    accent-color`, so libadwaita/GNOME apps stay on their default blue.
//    This daemon serves the complete `org.freedesktop.appearance` namespace
//    (accent-color, color-scheme, contrast).
// 2. Under Hyprland no portal backend implements `org.freedesktop.impl.portal.Wallpaper`,
//    so "Set as Desktop Background" in browsers (Firefox, Chrome) and image viewers
//    fails. This daemon implements SetWallpaperURI to apply and persist wallpapers.
//
// ⚠️ THREE BACKENDS BELOW ARE IMPLEMENTED BUT NOT ROUTED (2026-08-24):
// Account, DynamicLauncher and Background. They are still exported on the bus, but
// `config/portal/nidara.portal` no longer advertises those interfaces and
// `hyprland-portals.conf` no longer names us for them, so xdg-desktop-portal does
// not send them here.
//
// WHY: all three GRANT WITHOUT ASKING. `GetUserInformation` hands the real name and
// avatar to any caller; `PrepareInstall` / `RequestInstallToken` approve a launcher
// with the caller's own name and icon unreviewed; `NotifyBackground` always answers
// "allow". An `impl.portal` backend IS the place where the desktop asks the user —
// one that says yes to everything has implemented the interface and deleted the
// policy. And for Account and DynamicLauncher it was a REGRESSION, not a gap:
// `gtk.portal` declares both and shows a real dialog.
//
// The code is kept, not deleted, because the shape is right and only the consent
// step is missing. Read tech-debt #89 before re-routing any of them: it says what
// "asks" has to mean, and it is more than showing a dialog.
// ─────────────────────────────────────────────────────────────────────────────

import Gio from "gi://Gio"
import GLib from "gi://GLib"

// KEEP IN SYNC with ui/lib/accent.ts ACCENT_HEX (single source of truth for
// the palette). Duplicated here because this daemon is a standalone GJS
// script with no access to the TS bundles.
const ACCENT_HEX = {
    blue:   "#0088FF",
    teal:   "#2190a4",
    green:  "#79B757",
    yellow: "#F3BA4B",
    orange: "#E9873A",
    red:    "#ED5F5D",
    pink:   "#E55E9C",
    purple: "#9A57A3",
    slate:  "#6f8396",
}

const APPEARANCE_NS = "org.freedesktop.appearance"

// ── Our own namespace ────────────────────────────────────────────────────────
// `org.freedesktop.appearance` is a THREE-KEY spec: accent, colour scheme,
// contrast. It is the right channel for those and the reason third-party GTK apps
// follow Nidara's accent at all — but it has no room for the desktop's own
// vocabulary, and the accent it carries is an (r,g,b) triple, not the palette KEY
// our surfaces index by.
//
// So Nidara serves a second namespace beside it. The Settings portal's ReadAll
// takes a LIST of namespaces and merges what every impl backend answers, so a
// caller asks for both in one round trip and gets one dictionary back. That is
// what makes this worth doing instead of every bundle opening the file itself:
// one read, one `SettingChanged` signal, and it crosses a sandbox boundary — a
// Flatpak app cannot see `~/.config/nidara/appearance.json` and can see this.
//
// ⚠️ The file remains the SOURCE; this is a view of it. `ThemeManager` owns
// appearance.json and always will, because one surface cannot reach the portal at
// all: the greeter runs as the `greeter` system user, in its own compositor, with
// no session portal — and a portal there would answer for the wrong user anyway.
// Any consumer therefore needs the file fallback regardless (see
// `ui/lib/appearance.ts`), and this namespace must never become the only copy.
const NIDARA_NS = "org.nidara.appearance"

/** Where ThemeManager writes, in the order `ui/lib/appearance.ts` also tries. */
const APPEARANCE_PATHS = [
    `${GLib.get_user_config_dir()}/nidara/appearance.json`,
    "/var/tmp/nidara/appearance.json",
]
const BUS_NAME = "org.freedesktop.impl.portal.desktop.nidara"
const OBJECT_PATH = "/org/freedesktop/portal/desktop"

const SETTINGS_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Settings">
    <property name="version" type="u" access="read"/>
    <method name="ReadAll">
      <arg type="as" name="namespaces" direction="in"/>
      <arg type="a{sa{sv}}" name="value" direction="out"/>
    </method>
    <method name="Read">
      <arg type="s" name="namespace" direction="in"/>
      <arg type="s" name="key" direction="in"/>
      <arg type="v" name="value" direction="out"/>
    </method>
    <signal name="SettingChanged">
      <arg type="s" name="namespace"/>
      <arg type="s" name="key"/>
      <arg type="v" name="value"/>
    </signal>
  </interface>
</node>`

const WALLPAPER_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Wallpaper">
    <method name="SetWallpaperURI">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="uri" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
    </method>
  </interface>
</node>`

const DYNAMIC_LAUNCHER_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.DynamicLauncher">
    <property name="version" type="u" access="read"/>
    <property name="SupportedLauncherTypes" type="u" access="read"/>
    <method name="PrepareInstall">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="v" name="icon_v" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In5" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
    <method name="RequestInstallToken">
      <arg type="s" name="app_id" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
    </method>
  </interface>
</node>`

const ACCOUNT_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Account">
    <property name="version" type="u" access="read"/>
    <method name="GetUserInformation">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="window" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In3" value="QVariantMap"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
  </interface>
</node>`

const BACKGROUND_IFACE_XML = `
<node>
  <interface name="org.freedesktop.impl.portal.Background">
    <method name="GetAppState">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
      <arg type="a{sv}" name="apps" direction="out"/>
    </method>
    <method name="NotifyBackground">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="name" direction="in"/>
      <arg type="u" name="response" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out1" value="QVariantMap"/>
      <arg type="a{sv}" name="results" direction="out"/>
    </method>
    <method name="EnableAutostart">
      <arg type="s" name="app_id" direction="in"/>
      <arg type="b" name="enable" direction="in"/>
      <arg type="as" name="commandline" direction="in"/>
      <arg type="u" name="flags" direction="in"/>
      <arg type="b" name="result" direction="out"/>
    </method>
    <signal name="RunningApplicationsChanged">
    </signal>
  </interface>
</node>`

const interfaceSettings = new Gio.Settings({ schema_id: "org.gnome.desktop.interface" })
let a11ySettings = null
try {
    a11ySettings = new Gio.Settings({ schema_id: "org.gnome.desktop.a11y.interface" })
} catch (_) {}

function getUserAvatarUri() {
    const home = GLib.get_home_dir()
    const username = GLib.get_user_name()
    const candidates = [
        `${home}/.face`,
        `${home}/.face.icon`,
        `/var/lib/AccountsService/icons/${username}`,
        `${GLib.get_user_data_dir()}/nidara/avatar.png`,
    ]
    for (const candidate of candidates) {
        if (GLib.file_test(candidate, GLib.FileTest.EXISTS)) {
            return GLib.filename_to_uri(candidate, null) || `file://${candidate}`
        }
    }
    return ""
}

function getUserDisplayName() {
    const realName = GLib.get_real_name()
    if (realName && realName !== "Unknown" && realName.trim().length > 0) {
        return realName
    }
    return GLib.get_user_name()
}

function accentRgbVariant() {
    const name = interfaceSettings.get_string("accent-color")
    const hex = ACCENT_HEX[name] ?? ACCENT_HEX.blue
    const r = parseInt(hex.slice(1, 3), 16) / 255
    const g = parseInt(hex.slice(3, 5), 16) / 255
    const b = parseInt(hex.slice(5, 7), 16) / 255
    return new GLib.Variant("(ddd)", [r, g, b])
}

function colorSchemeVariant() {
    // 0: no preference, 1: prefer-dark, 2: prefer-light
    //
    // ⚠️ THE ENUM HAS THREE VALUES, NOT TWO. `gsettings range` gives
    // `default | prefer-dark | prefer-light`, and this used to read
    // `scheme === "prefer-light" ? 2 : 1` — which reported `default` as "prefer
    // DARK" to every app that asked. Nidara now seeds `prefer-light` explicitly
    // (defaults/appearance.json + ThemeManager.applyAll), so the bad branch is
    // rarely reached on our own installs; it was wrong for everyone else.
    const scheme = interfaceSettings.get_string("color-scheme")
    const val = scheme === "prefer-light" ? 2 : scheme === "prefer-dark" ? 1 : 0
    return new GLib.Variant("u", val)
}

/** The desktop's own appearance state, as ThemeManager last wrote it. */
function readNidaraAppearance() {
    for (const path of APPEARANCE_PATHS) {
        try {
            const [ok, data] = GLib.file_get_contents(path)
            if (!ok) continue
            return JSON.parse(new TextDecoder().decode(data))
        } catch (_) { /* try the next one */ }
    }
    return {}
}

/**
 * Our namespace's payload. Kebab-case keys, like every other portal namespace.
 *
 * Only what a SECOND process needs to look like Nidara. Not the whole file: the
 * icon/cursor/font settings already reach apps through `org.gnome.desktop.interface`
 * (the gtk backend serves that from gsettings, which ThemeManager writes), and
 * duplicating them here would create a second answer to a question that already
 * has one.
 */
function nidaraKeys() {
    const a = readNidaraAppearance()
    const num = (v, dflt) => (typeof v === "number" && isFinite(v) ? v : dflt)
    return {
        "accent": new GLib.Variant("s", typeof a.accent === "string" ? a.accent : "blue"),
        // A MISSING key means light, matching the shell's own DEFAULT_CONFIG.
        "is-dark": new GLib.Variant("b", a.isDark === true),
        "window-opacity": new GLib.Variant("d", num(a.windowOpacity, 0.48)),
        "bar-opacity": new GLib.Variant("d", num(a.barOpacity, 0.48)),
        "overlay-opacity": new GLib.Variant("d", num(a.overlayOpacity, 0.48)),
        "dock-opacity": new GLib.Variant("d", num(a.dockOpacity, 0.24)),
        "shell-appearance": new GLib.Variant("s",
            typeof a.shellAppearance === "string" ? a.shellAppearance : "system"),
    }
}

function contrastVariant() {
    // 0: no preference, 1: high contrast
    let val = 0
    if (a11ySettings) {
        try {
            if (a11ySettings.get_boolean("high-contrast")) val = 1
        } catch (_) {}
    }
    return new GLib.Variant("u", val)
}

/**
 * Does this ReadAll's namespace list ask for `ns`?
 *
 * An empty list (or an empty pattern in it) means "everything", per the portal
 * spec — and the patterns are glob-style, so `org.freedesktop.*` has to match.
 */
function nsMatches(patterns, ns) {
    if (!patterns || patterns.length === 0) return true
    return patterns.some(p => p === "" || GLib.pattern_match_simple(p, ns))
}

function decodeUriToPath(uri) {
    if (!uri) return null
    if (uri.startsWith("file://")) {
        try {
            const [path] = GLib.filename_from_uri(uri)
            return path
        } catch (_) {
            return decodeURIComponent(uri.replace(/^file:\/\//, ""))
        }
    }
    if (uri.startsWith("/")) return uri
    return null
}

function applyWallpaperFallback(path) {
    const configDir = `${GLib.get_user_config_dir()}/nidara`
    GLib.mkdir_with_parents(configDir, 0o755)
    const cfgPath = `${configDir}/wallpaper`
    let cfg = {}
    try {
        const [ok, contents] = GLib.file_get_contents(cfgPath)
        if (ok) cfg = JSON.parse(new TextDecoder().decode(contents))
    } catch (_) {}
    cfg.path = path
    cfg.transition = cfg.transition || "random"
    GLib.file_set_contents(cfgPath, JSON.stringify(cfg))
    // ⚠️ ARGV, NOT A COMMAND STRING. `path` arrives inside a URI handed over by ANY
    // app that calls the Wallpaper portal, and `cfg.transition` is read back out of a
    // JSON file on disk. Interpolating either into a string and letting
    // `spawn_command_line_async` split it means a filename containing a quote injects
    // extra arguments into awww. (It is argument injection rather than command
    // execution — `g_shell_parse_argv` does not run a shell — but the fix is the same
    // and it is the rule the computer-use helpers already follow: fixed argv, never a
    // shell.)
    try {
        Gio.Subprocess.new(
            ["awww", "img", path, "--transition-type", String(cfg.transition)],
            Gio.SubprocessFlags.NONE,
        )
    } catch (e) {
        printerr(`[nidara-portal] awww fallback failed: ${e}`)
    }
}

// ── Settings Backend ─────────────────────────────────────────────────────────
class SettingsBackend {
    get version() { return 1 }

    ReadAllAsync(params, invocation) {
        const [namespaces] = params
        const dict = {}
        if (nsMatches(namespaces, APPEARANCE_NS)) {
            dict[APPEARANCE_NS] = {
                "accent-color": accentRgbVariant(),
                "color-scheme": colorSchemeVariant(),
                "contrast": contrastVariant(),
            }
        }
        if (nsMatches(namespaces, NIDARA_NS)) dict[NIDARA_NS] = nidaraKeys()
        invocation.return_value(new GLib.Variant("(a{sa{sv}})", [dict]))
    }

    ReadAsync(params, invocation) {
        const [namespace, key] = params
        if (namespace === APPEARANCE_NS) {
            if (key === "accent-color") {
                invocation.return_value(new GLib.Variant("(v)", [accentRgbVariant()]))
                return
            }
            if (key === "color-scheme") {
                invocation.return_value(new GLib.Variant("(v)", [colorSchemeVariant()]))
                return
            }
            if (key === "contrast") {
                invocation.return_value(new GLib.Variant("(v)", [contrastVariant()]))
                return
            }
        }
        if (namespace === NIDARA_NS) {
            const keys = nidaraKeys()
            if (keys[key]) {
                invocation.return_value(new GLib.Variant("(v)", [keys[key]]))
                return
            }
        }
        // Fall through to other portal backends in portals.conf (e.g. gtk for font-name)
        invocation.return_dbus_error(
            "org.freedesktop.portal.Error.NotFound",
            `nidara-portal does not serve ${namespace} ${key}`,
        )
    }
}

// ── Wallpaper Backend ────────────────────────────────────────────────────────
class WallpaperBackend {
    SetWallpaperURIAsync(params, invocation) {
        const [, appId, , uri] = params
        print(`[nidara-portal] SetWallpaperURI requested by ${appId || "unknown"}: ${uri}`)

        const srcPath = decodeUriToPath(uri)
        if (!srcPath || !GLib.file_test(srcPath, GLib.FileTest.EXISTS)) {
            printerr(`[nidara-portal] Wallpaper file does not exist: ${srcPath}`)
            // Response 2 = Failed
            invocation.return_value(new GLib.Variant("(u)", [2]))
            return
        }

        let targetPath = srcPath
        // If image is in a temporary or sandbox location (/tmp, /run/user/..., /doc/),
        // copy it to user's persistent wallpapers folder so it persists after the app closes.
        if (srcPath.startsWith("/tmp/") || srcPath.startsWith("/run/user/") || srcPath.includes("/doc/")) {
            const wallDir = `${GLib.get_user_data_dir()}/nidara/wallpapers`
            GLib.mkdir_with_parents(wallDir, 0o755)
            const baseName = GLib.path_get_basename(srcPath)
            const destPath = `${wallDir}/${Date.now()}_${baseName}`
            try {
                const srcFile = Gio.File.new_for_path(srcPath)
                const destFile = Gio.File.new_for_path(destPath)
                srcFile.copy(destFile, Gio.FileCopyFlags.OVERWRITE, null, null)
                targetPath = destPath
                print(`[nidara-portal] Cached temporary wallpaper to: ${targetPath}`)
            } catch (e) {
                printerr(`[nidara-portal] Failed to copy temporary wallpaper: ${e}`)
            }
        }

        // Apply wallpaper via nidara-ipc (if shell running) or fallback
        // Same argv rule as the fallback below — `targetPath` is caller-supplied.
        try {
            const proc = Gio.Subprocess.new(
                ["nidara-ipc", "setWallpaper", targetPath],
                Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
            )
            proc.wait(null)
            if (!proc.get_successful()) {
                applyWallpaperFallback(targetPath)
            }
        } catch (_) {
            applyWallpaperFallback(targetPath)
        }

        // Response 0 = Success
        invocation.return_value(new GLib.Variant("(u)", [0]))
    }
}

// ── Dynamic Launcher Backend ────────────────────────────────────────────────
class DynamicLauncherBackend {
    get version() { return 1 }
    get SupportedLauncherTypes() { return 3 } // 1 (App) + 2 (Webapp)

    PrepareInstallAsync(params, invocation) {
        const [, appId, , name, iconVariant] = params
        print(`[nidara-portal] PrepareInstall requested for "${name}" by ${appId || "unknown"}`)

        // Return 0 (Success) with the chosen name and icon for xdg-desktop-portal to install
        const results = {
            name: new GLib.Variant("s", name || "Web App"),
            icon: iconVariant,
        }
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }

    RequestInstallTokenAsync(params, invocation) {
        const [appId] = params
        print(`[nidara-portal] RequestInstallToken requested by ${appId || "unknown"}`)
        // Response 0 = Allowed
        invocation.return_value(new GLib.Variant("(u)", [0]))
    }
}

// ── Account Backend ─────────────────────────────────────────────────────────
class AccountBackend {
    get version() { return 1 }

    GetUserInformationAsync(params, invocation) {
        const [, appId] = params
        const username = GLib.get_user_name()
        const realName = getUserDisplayName()
        const imageUri = getUserAvatarUri()

        print(`[nidara-portal] GetUserInformation requested by ${appId || "unknown"} for ${username} ("${realName}")`)

        const results = {
            id: new GLib.Variant("s", username),
            name: new GLib.Variant("s", realName),
        }
        if (imageUri) {
            results.image = new GLib.Variant("s", imageUri)
        }

        // Response 0 = Success
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }
}

// ── Background Backend ──────────────────────────────────────────────────────
class BackgroundBackend {
    GetAppStateAsync(params, invocation) {
        // Return mapping of app states (0=Background, 1=Running, 2=Active)
        invocation.return_value(new GLib.Variant("(a{sv})", [{}]))
    }

    NotifyBackgroundAsync(params, invocation) {
        const [, appId, name] = params
        print(`[nidara-portal] NotifyBackground requested for "${name || appId || "unknown"}"`)
        // 1 = Allow background activity
        const results = {
            result: new GLib.Variant("u", 1),
        }
        invocation.return_value(new GLib.Variant("(ua{sv})", [0, results]))
    }

    EnableAutostartAsync(params, invocation) {
        const [appId, enable, commandline] = params
        print(`[nidara-portal] EnableAutostart requested for ${appId}: ${enable}`)
        const autostartDir = `${GLib.get_user_config_dir()}/autostart`
        GLib.mkdir_with_parents(autostartDir, 0o755)
        const desktopPath = `${autostartDir}/${appId}.desktop`

        if (enable) {
            const exec = (commandline && commandline.length > 0) ? commandline.join(" ") : appId
            const content = `[Desktop Entry]\nType=Application\nName=${appId}\nExec=${exec}\nX-GNOME-Autostart-enabled=true\n`
            GLib.file_set_contents(desktopPath, content)
        } else {
            if (GLib.file_test(desktopPath, GLib.FileTest.EXISTS)) {
                try {
                    Gio.File.new_for_path(desktopPath).delete(null)
                } catch (_) {}
            }
        }
        invocation.return_value(new GLib.Variant("(b)", [true]))
    }
}

/**
 * Watch the appearance file and report the keys whose value changed.
 *
 * Returns the monitor, which the caller MUST keep — see the note at the call site.
 * The file that gets watched is the first one that exists, in the same order the
 * reader tries: a session normally has `~/.config`, and `/var/tmp` is the mirror.
 */
function watchNidaraAppearance(onChanged) {
    const path = APPEARANCE_PATHS.find(p => GLib.file_test(p, GLib.FileTest.EXISTS))
    if (!path) return null

    let previous = nidaraKeys()
    let monitor = null
    try {
        monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, null)
    } catch (e) {
        printerr(`[nidara-portal] cannot watch ${path}: ${e}`)
        return null
    }

    monitor.connect("changed", () => {
        const next = nidaraKeys()
        for (const key of Object.keys(next)) {
            // `equal()` compares the VALUE, not the boxed variant's identity.
            if (previous[key] && next[key].equal(previous[key])) continue
            onChanged(key, next[key])
        }
        previous = next
    })
    return monitor
}

let appearanceMonitor = null

const loop = new GLib.MainLoop(null, false)
const settingsBackend = new SettingsBackend()
const wallpaperBackend = new WallpaperBackend()
const dynamicLauncherBackend = new DynamicLauncherBackend()
const accountBackend = new AccountBackend()
const backgroundBackend = new BackgroundBackend()

const exportedSettings = Gio.DBusExportedObject.wrapJSObject(SETTINGS_IFACE_XML, settingsBackend)
const exportedWallpaper = Gio.DBusExportedObject.wrapJSObject(WALLPAPER_IFACE_XML, wallpaperBackend)
const exportedDynamicLauncher = Gio.DBusExportedObject.wrapJSObject(DYNAMIC_LAUNCHER_IFACE_XML, dynamicLauncherBackend)
const exportedAccount = Gio.DBusExportedObject.wrapJSObject(ACCOUNT_IFACE_XML, accountBackend)
const exportedBackground = Gio.DBusExportedObject.wrapJSObject(BACKGROUND_IFACE_XML, backgroundBackend)

Gio.bus_own_name(
    Gio.BusType.SESSION,
    BUS_NAME,
    Gio.BusNameOwnerFlags.NONE,
    (connection) => {
        exportedSettings.export(connection, OBJECT_PATH)
        exportedWallpaper.export(connection, OBJECT_PATH)
        exportedDynamicLauncher.export(connection, OBJECT_PATH)
        exportedAccount.export(connection, OBJECT_PATH)
        exportedBackground.export(connection, OBJECT_PATH)

        // Live appearance updates
        interfaceSettings.connect("changed::accent-color", () => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [APPEARANCE_NS, "accent-color", accentRgbVariant()]),
            )
        })

        interfaceSettings.connect("changed::color-scheme", () => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [APPEARANCE_NS, "color-scheme", colorSchemeVariant()]),
            )
        })

        if (a11ySettings) {
            a11ySettings.connect("changed::high-contrast", () => {
                exportedSettings.emit_signal(
                    "SettingChanged",
                    new GLib.Variant("(ssv)", [APPEARANCE_NS, "contrast", contrastVariant()]),
                )
            })
        }

        // Our namespace changes when the FILE changes, so the signal comes from a
        // file monitor rather than a gsettings key. Held in a module-level
        // variable: an unreferenced Gio.FileMonitor is collected and stops
        // delivering with no error at all.
        //
        // Only the keys that actually MOVED are announced. The file is rewritten
        // on every frame of an opacity slider drag, and a namespace that re-emits
        // all seven keys per write would make every listener rebuild its whole
        // stylesheet sixty times a second.
        appearanceMonitor = watchNidaraAppearance((key, value) => {
            exportedSettings.emit_signal(
                "SettingChanged",
                new GLib.Variant("(ssv)", [NIDARA_NS, key, value]),
            )
        })

        print(`[nidara-portal] serving Settings + Wallpaper + DynamicLauncher + Account + Background on ${BUS_NAME}`)
    },
    null,
    () => {
        printerr(`[nidara-portal] lost/failed bus name ${BUS_NAME} — exiting`)
        loop.quit()
    },
)

loop.run()
