#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# nidara-doctor — diagnostic snapshot of a Nidara installation
# Installed to /usr/bin/nidara-doctor
#
# One command that gathers everything needed to diagnose a problem or to attach
# as evidence to a bug report / PR: versions, hardware, compositor state, the
# shell's own live state (via `nidara-ipc dumpState`), and recent log errors.
# Output is Markdown — paste it directly into a GitHub issue or PR body.
#
# This is also the agent entry point: an AI agent helping a user should run
# this FIRST when something misbehaves, and include it when proposing a
# hardware/compat fix upstream (see the nidara skill,
# references/agent-contribution.md — evidence IS the test).
#
# Every section degrades gracefully: a missing tool/daemon prints "n/a" instead
# of aborting, so the report is useful even on a half-broken setup.
#
# Usage:  nidara-doctor            # full report to stdout
#         nidara-doctor --log [file]  # only the shell log's warnings since the last
#                                     # start, grouped and counted (also what CI's
#                                     # smoke job prints)
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nidara"
LOG="${XDG_RUNTIME_DIR:-/tmp}/nidara-ui.log"

# `cmd args…` → run, indent as a code block; print "n/a (reason)" on failure.
section() { printf '\n## %s\n\n' "$1"; }
codeblock() {
    local out
    if out=$("$@" 2>&1) && [ -n "$out" ]; then
        printf '```\n%s\n```\n' "$out"
    else
        printf '_n/a (`%s` failed or empty)_\n' "$*"
    fi
}

# The shell log's CRITICAL/WARNING lines since the shell last started, grouped:
# one line per kind, most frequent first. A raw tail shows whichever message
# happened to fire last; a count shows what is actually broken. The log carries
# every run since login, so it starts at the LAST start marker nidara-ui wrote.
# Numbers and addresses are masked to decide what counts as one kind, and the
# FIRST real message of each kind is what gets printed.
# Measured 2026-09-27: 2821 texture CRITICALs a day (chevrons broken for days)
# and a game-mode push failing on every start — both invisible in a tail of 40.
log_summary() {
    local file="${1:-$LOG}"
    [ -r "$file" ] || { echo "n/a (no log at $file)"; return 1; }
    awk '
        /nidara-ui: (DEV mode|bundle)/ { split("", n); split("", shown); k = 0; since = $1 }
        /(CRITICAL|WARNING) \*\*/ {
            line = $0
            sub(/^\([^)]*\): /, "", line)
            sub(/ [0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9]+:/, "", line)
            key = line
            gsub(/0x[0-9a-f]+/, "0x", key); gsub(/[0-9]+/, "N", key)
            key = substr(key, 1, 160)
            if (!(key in n)) { keys[++k] = key; shown[key] = substr(line, 1, 200) }
            n[key]++
        }
        END {
            printf "since %s — %d kind(s)\n", (since ? since : "the start of the log"), k
            for (i = 1; i <= k; i++) for (j = i + 1; j <= k; j++)
                if (n[keys[j]] > n[keys[i]]) { t = keys[i]; keys[i] = keys[j]; keys[j] = t }
            for (i = 1; i <= k; i++) printf "%6d  %s\n", n[keys[i]], shown[keys[i]]
        }' "$file"
}

if [ "${1:-}" = "--log" ]; then
    log_summary "${2:-$LOG}"
    exit $?
fi

echo "# Nidara — diagnostic report ($(date -u '+%Y-%m-%d %H:%M UTC'))"

section "Versions"
{
    ver="?"
    if [ -f "$CONFIG_DIR/.dev" ] && [ -f "$(cat "$CONFIG_DIR/.dev")/VERSION" ]; then
        ver="$(cat "$(cat "$CONFIG_DIR/.dev")/VERSION") (dev checkout: $(cat "$CONFIG_DIR/.dev"))"
    elif [ -f /usr/share/nidara/VERSION ]; then
        ver="$(cat /usr/share/nidara/VERSION) (system install)"
    fi
    echo '```'
    echo "nidara: $ver"
    echo "hyprland:      $(hyprctl version 2>/dev/null | head -1 || echo n/a)"
    echo "hyalo:         $(nidara-hyalo --version 2>/dev/null || echo n/a)"
    echo "gjs:           $(gjs --version 2>/dev/null || echo n/a)"
    echo "esbuild:       $(esbuild --version 2>/dev/null || echo n/a)"
    echo "gtk4:          $(pacman -Q gtk4 2>/dev/null || echo n/a)"
    echo "kernel:        $(uname -r)"
    echo "os:            $(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || echo n/a)"
    echo '```'
}

section "Hardware"
codeblock sh -c "lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display|network|wireless' ; lscpu 2>/dev/null | grep 'Model name' ; free -h 2>/dev/null | grep Mem"

section "Monitors"
codeblock sh -c "nidara-wm monitors 2>/dev/null | head -100"

# Hyalo (#680), only when it is installed: its outputs when it is the running compositor,
# and the newest crash report it left. A compositor crash ends the session, so the report
# is all that is left of it by the time anybody runs this — from the next session.
if command -v nidara-hyalo >/dev/null 2>&1; then
    if [ -n "${HYALO_SOCKET:-}" ]; then
        section "Monitors (Hyalo)"
        codeblock nidara-hyalo msg outputs
    fi
    hyalo_crashes="${XDG_STATE_HOME:-$HOME/.local/state}/nidara/hyalo"
    hyalo_last="$(ls -1 "$hyalo_crashes"/crash-*.txt 2>/dev/null | sort | tail -1)"
    if [ -n "$hyalo_last" ]; then
        section "Hyalo: latest crash report ($(ls -1 "$hyalo_crashes"/crash-*.txt | wc -l) kept, $hyalo_last)"
        codeblock head -60 "$hyalo_last"
    fi
fi

section "Shell service (systemd --user)"
codeblock systemctl --user --no-pager status nidara

section "Shell live state (nidara-ipc dumpState)"
codeblock nidara-ipc dumpState

section "Idle wakeups (main thread, 4 s sample — healthy ≈ 0/s when idle)"
{
    # Match the shell's DECODED bundle, whatever named it: scripts/bundle.sh writes
    # $XDG_RUNTIME_DIR/nidara-<hash>.js and scripts/run.sh nidara-run-app.js. (It was
    # `…/ags.js` until 2026-08-18 — a pattern that silently matched nothing after the
    # bundler changed, and this section would just print "shell process not found".)
    SHELL_PID=$(pgrep -f "gjs -m .*/nidara.*\.js" | head -1)
    if [ -n "${SHELL_PID:-}" ]; then
        TS="/proc/$SHELL_PID/task/$SHELL_PID/status"
        W1=$(awk '/voluntary/{s+=$2} END{print s}' "$TS" 2>/dev/null)
        sleep 4
        W2=$(awk '/voluntary/{s+=$2} END{print s}' "$TS" 2>/dev/null)
        printf '```\n%s wakeups/s\n```\n' "$(( (W2-W1)/4 ))"
    else
        printf '_n/a (shell process not found)_\n'
    fi
}

section "Shell log since the last start: warnings by kind"
codeblock log_summary

section "Recent log errors (last 40 matching lines of $LOG)"
codeblock sh -c "grep -iE 'error|critical|warning|failed|exception' '$LOG' 2>/dev/null | tail -40"

section "Config layer (what exists in $CONFIG_DIR)"
codeblock sh -c "ls -la '$CONFIG_DIR' 2>/dev/null"

echo
echo "_Generated by nidara-doctor. Personal values (wallpaper, pinned apps,"
echo "accent) are not included beyond file names; review before posting publicly._"
