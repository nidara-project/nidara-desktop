#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# nidara-before-sleep — hypridle before_sleep_cmd
# Installed to /usr/bin/nidara-before-sleep
# Locks the session before suspend.
#
# It also used to save the volume to /tmp/.nidara-vol for after-sleep to restore
# (2026-05-09, "waits for WP stabilisation"). That pair is gone: WirePlumber
# persists and restores endpoint volume by itself, so the save/restore only
# added a second writer with no owner — see nidara-after-sleep for the
# measurement.
# ─────────────────────────────────────────────────────────────────────────────

# Lock via logind: hypridle receives the dbus lock event and runs lock_cmd
# (nidara-lock) detached. Must NOT call nidara-lock here directly — it blocks
# until unlock, and hypridle holds the sleep inhibitor until this returns.
loginctl lock-session 2>/dev/null || true
