#!/usr/bin/env -S gjs -m
// ─────────────────────────────────────────────────────────────────────────────
// nidara-type — SYNTHETIC KEYBOARD for the computer-use layer (Phase 2b-i).
// Installed to /usr/bin/nidara-type. Types text / presses keys into a
// third-party app via `wtype` (Wayland-native zwp_virtual_keyboard, no daemon),
// for controls that AT-SPI `do_action` can't reach — e.g. typing into a Qt
// text field, or pressing Enter/Space to activate a Qt button (those expose
// only SetFocus).
//
// TWO DIFFERENT KINDS OF FOCUS, and confusing them cost a step in a live run:
//   • the WINDOW must be Hyprland's active one — that is the gate below, and the
//     only verb for it is `focus_window`. `nidara-act … SetFocus` cannot do this.
//   • the CONTROL inside it: `nidara-act <app> <node> SetFocus` works ONLY where
//     the toolkit exposes that action (Qt usually does; GTK4 usually does not —
//     it dropped ATK, so Component.GrabFocus returns false and many nodes carry an
//     empty action list). To put a NUMBER somewhere, don't aim a keyboard at all:
//     `nidara-act <app> <node> set-value=N` sets it and reads the result back.
//
//   nidara-type text <app> <string>     e.g. nidara-type text telegram "hola"
//   nidara-type key  <app> <keyspec>    e.g. nidara-type key telegram Return
//                                             nidara-type key nautilus ctrl+a
//
// SEPARATE binary from nidara-a11y (perceive) and nidara-act (AT-SPI action):
// synthetic input is a distinct mechanism and the maintainer guardian rule keeps
// it out of the other helpers.
//
// SAFETY — synthetic keyboard is FOCUS-DEPENDENT (wtype types into whatever
// window has focus), unlike do_action. So <app> is REQUIRED and we verify it is
// Hyprland's ACTIVE window before injecting; otherwise we refuse. A keystroke
// can only land in the app the agent named, while it is actually focused.
//
// Governance: same gate as nidara-act — BOTH `allowComputerControl` AND
// `allowComputerUse` must be true in ai.json (Settings → AI). The shell shows
// the always-visible "AI CONTROL" indicator + kill switch while control is on.
// Consent layer, not a security boundary (any local process can run wtype).
// ─────────────────────────────────────────────────────────────────────────────

import GLib from "gi://GLib"
import Gio from "gi://Gio"

const AI_JSON = `${GLib.get_user_config_dir()}/nidara/ai.json`

function emit(obj) { print(JSON.stringify(obj, null, 2)) }

// Fire-and-forget: tell the shell an action just landed so the bar's AI-control
// indicator shows its "active" pulse (decays back to "armed" after a few seconds).
// Never blocks or fails the action if the shell isn't reachable.
//
// Gio, NOT spawn_command_line_async: the latter cannot redirect stdio, so the
// child INHERITS ours and the `ags` CLI's reply ("ok") lands on OUR stdout — right
// after the JSON we just printed. That breaks the one-JSON-per-helper contract the
// daemon parses, so a successful injection came back to the model as a FAILURE, and
// deterministically: the daemon reads to EOF, and the pipe's write end stays open
// until this child exits too, so the "ok" is always waited for. It stayed hidden
// while the focus gate refused every call from the Assistant before reaching here.
function pingShell() {
    try {
        Gio.Subprocess.new(["nidara-ipc", "notifyComputerAction"],
            Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
    } catch {}
}

// Both gates required; both default OFF (absent/garbled ai.json → disabled).
function controlEnabled() {
    try {
        if (!GLib.file_test(AI_JSON, GLib.FileTest.EXISTS)) return false
        const [ok, bytes] = GLib.file_get_contents(AI_JSON)
        if (!ok) return false
        const cfg = JSON.parse(new TextDecoder().decode(bytes))
        return cfg.allowComputerControl === true && cfg.allowComputerUse === true
    } catch {
        return false
    }
}

function run(argv) {
    const proc = Gio.Subprocess.new(
        argv,
        Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE,
    )
    const [, out, err] = proc.communicate_utf8(null, null)
    return { ok: proc.get_successful(), out: (out ?? "").trim(), err: (err ?? "").trim() }
}

// Ask the shell to step out of the way for this injection, and hand the keyboard
// back after. While one of Nidara's own layer surfaces holds an EXCLUSIVE keyboard
// grab — which the Assistant island does the entire time the user is typing at it —
// Hyprland refuses to move window focus at all (FocusState.cpp: "Refusing a keyboard
// focus to a window because of an exclusive ls"), so the focus gate below could never
// pass; and the keyboard genuinely belongs to that surface, so injecting anyway would
// type into the Assistant's own prompt. `begin` answers only once the compositor has
// APPLIED the release, so it is deliberately synchronous. A shell that is down, or too
// old to know the command, is a silent no-op; if we die before `end`, the shell
// restores itself.
function yieldInput(verb) {
    try { GLib.spawn_command_line_sync(`timeout 3 nidara-ipc yieldInput ${verb}`) } catch {}
}

// Hyprland's focused window class (lowercased), e.g. "telegramdesktop".
function hyprActiveClass() {
    try {
        const [ok, out] = GLib.spawn_command_line_sync("hyprctl activewindow -j")
        if (!ok) return null
        const cls = (JSON.parse(new TextDecoder().decode(out)).class || "").toLowerCase()
        return cls || null
    } catch {
        return null
    }
}

// ── one name per app ───────────────────────────────────────────────────────────
// KEEP IDENTICAL in nidara-a11y, nidara-act and nidara-click — see the long
// comment in nidara-a11y for the why. Short version: one app wears three names
// (Hyprland class / AT-SPI name / .desktop name), substrings cannot bridge them
// once a version digit moves sides, and a live run on 2026-08-01 paid six steps
// because perception named the app one way and action demanded another.
const NAME_NOISE = new Set(["org", "com", "io", "net", "app", "desktop"])
const nameTokens = (s) => (s || "")
    .replace(/([a-z])([A-Z])/g, "$1 $2")   // camelCase  → "Widget Factory"
    .replace(/([a-zA-Z])(\d)/g, "$1 $2")   // Factory4   → "Factory 4"
    .replace(/(\d)([a-zA-Z])/g, "$1 $2")   // gtk4       → "gtk 4"
    .toLowerCase()
    .split(/[^a-z0-9]+/)
    .filter(t => t && !NAME_NOISE.has(t))

function sameApp(a, b) {
    const la = (a || "").toLowerCase(), lb = (b || "").toLowerCase()
    if (!la || !lb) return false
    if (la === lb || la.includes(lb) || lb.includes(la)) return true
    // Tokenize the ORIGINAL strings, never the lowercased ones: the word breaks of
    // "WidgetFactory" live in its capitals, and lowercasing first is exactly the
    // bug this function exists to kill (it fused "widgetfactory" into one token).
    const ta = nameTokens(a), tb = nameTokens(b)
    if (ta.length && tb.length) {
        const [small, big] = ta.length <= tb.length ? [ta, tb] : [tb, ta]
        const set = new Set(big)
        if (small.every(t => set.has(t))) return true
    }
    // Last resort for a side that reaches us already lowercased — Hyprland's class
    // does — where the camelCase seams are gone for good: drop digits and
    // separators and compare bare letters. >2 chars so noise cannot match.
    const bare = (s) => s.toLowerCase().replace(/[^a-z]/g, "")
    const x = bare(a), y = bare(b)
    return x.length > 2 && y.length > 2 && (x.includes(y) || y.includes(x))
}

// Tolerant match between the user's <app> filter and the active window class
// ("telegram" vs "org.telegram.desktop"/"TelegramDesktop", and "gtk4-widget-factory"
// — the name query_app answers to — vs "org.gtk.WidgetFactory4").
function focusMatches(activeClass, app) {
    return sameApp(activeClass, app)
}

// The address of the window the caller MEANT, for the refusal to hand back. A
// refusal that only says "not focused" costs three steps to recover from — measured
// 2026-07-28 in a live run: type_text refused, then list_windows, then focus_window,
// then the retry. We already know which app was named, so the lookup belongs here.
// Runs ONLY on the refusal path: the happy path must not pay for a second hyprctl.
function focusHint(app) {
    try {
        const [ok, out] = GLib.spawn_command_line_sync("hyprctl clients -j")
        if (!ok) return null
        const wins = JSON.parse(new TextDecoder().decode(out))
        const hit = wins.find(w => focusMatches((w.class || "").toLowerCase(), app))
        return hit ? { address: hit.address, class: hit.class, title: hit.title } : null
    } catch {
        return null
    }
}

// wtype modifier names (it speaks xkb): map common aliases.
const MOD_MAP = {
    ctrl: "ctrl", control: "ctrl", ctl: "ctrl",
    alt: "alt", meta: "alt",
    shift: "shift",
    super: "logo", win: "logo", cmd: "logo", logo: "logo",
}
// Friendly key aliases → xkb keysym names (anything else is passed through).
const KEY_ALIAS = {
    enter: "Return", return: "Return", ret: "Return",
    esc: "Escape", escape: "Escape",
    tab: "Tab", space: "space", spc: "space",
    backspace: "BackSpace", bksp: "BackSpace", del: "Delete", delete: "Delete",
    up: "Up", down: "Down", left: "Left", right: "Right",
    home: "Home", end: "End", pageup: "Prior", pagedown: "Next",
}

// "ctrl+shift+t" → { mods:["ctrl","shift"], key:"t" }; rejects unknown modifiers.
function parseKeyspec(spec) {
    const parts = spec.split("+").map(p => p.trim()).filter(Boolean)
    if (!parts.length) return null
    const rawKey = parts.pop()
    const mods = []
    for (const m of parts) {
        const mod = MOD_MAP[m.toLowerCase()]
        if (!mod) return { error: `unknown modifier "${m}" (use ctrl/alt/shift/super)` }
        mods.push(mod)
    }
    const key = KEY_ALIAS[rawKey.toLowerCase()] ?? rawKey
    return { mods, key }
}

function main() {
    if (!controlEnabled()) {
        emit({ error: "computer-control is disabled — enable 'Allow Agents to Control Other Apps' in Settings → AI (it requires perception too; both default off)" })
        return
    }

    const mode = (ARGV[0] ?? "").trim()
    const app = (ARGV[1] ?? "").trim()
    const payload = ARGV[2] ?? ""

    if ((mode !== "text" && mode !== "key") || !app || payload === "") {
        emit({ error: "usage: nidara-type text|key <app> <string|keyspec>" })
        return
    }

    const wtype = GLib.find_program_in_path("wtype")
    if (!wtype) {
        emit({ error: "wtype not found — re-run install.sh (it is the Wayland keyboard backend)" })
        return
    }

    // Past the guards, so this call is going to inject: make room for it. The yield
    // wraps the FOCUS GATE too — before the shell lets go, the gate cannot pass by
    // construction, and the keystrokes would have gone to the Assistant's own entry
    // rather than to the app (see yieldInput).
    yieldInput("begin")
    try {
        return inject(mode, app, payload, wtype)
    } finally {
        yieldInput("end")
    }
}

function inject(mode, app, payload, wtype) {
    // Focus gate: only inject into the named app while it is actually focused.
    const active = hyprActiveClass()
    if (!focusMatches(active, app)) {
        // Name the remedy that WORKS. This used to say "do_app_action … SetFocus",
        // which is a dead end we had already measured: GTK4 dropped ATK, its AT-SPI
        // backend does not implement Component.GrabFocus, and most GTK4 nodes carry
        // an empty action list. In the live run of 2026-07-28 the model did exactly
        // what this string said and burned a step on it before recovering on its own.
        const hint = focusHint(app)
        emit({
            error: `refused: "${app}" is not the focused window (active: ${active ?? "unknown"}) — focus the WINDOW first with focus_window`
                // Say what we KNOW (no open window answers to that name), never what
                // we inferred ("it is not open"): on 2026-08-01 that inference was
                // false — the window was open AND focused under another of its names —
                // and the model spent two steps chasing the wrong remedy.
                + (hint ? ` (address ${hint.address}), then retry` : `; no open window answers to that name — run_action list_windows for the ones that are`),
            active,
            ...(hint ? { focus: hint } : {}),
        })
        return
    }

    let argv
    if (mode === "text") {
        argv = [wtype, "--", payload]
    } else {
        const parsed = parseKeyspec(payload)
        if (!parsed) { emit({ error: `invalid keyspec "${payload}"` }); return }
        if (parsed.error) { emit({ error: parsed.error }); return }
        argv = [wtype]
        for (const m of parsed.mods) argv.push("-M", m)
        argv.push("-k", parsed.key)
        for (const m of [...parsed.mods].reverse()) argv.push("-m", m)
    }

    const r = run(argv)
    if (!r.ok) {
        // wtype's own "Unknown key '*'" is true and useless: it names what failed and
        // not what to do, so the caller spends a round trip guessing. Measured on the
        // bench 2026-07-31 — `press_key *` failed, and the recovery (`type_text "*"`)
        // was a whole extra step. Keysyms are NAMES, and the verb that always works
        // for a literal character is the other one; say both.
        const hint = mode === "key"
            ? " — a keyspec is xkb keysym NAMES (Return, Tab, Escape, asterisk, plus), not the"
              + " character the key produces. For a literal character use text mode (type_text)."
            : ""
        emit({ ok: false, app, mode, error: `wtype failed: ${r.err || "no output"}${hint}` })
        return
    }
    pingShell()
    emit({ ok: true, app, mode, active })
}

main()
