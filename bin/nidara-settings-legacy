#!/usr/bin/env bash
# Independent Settings application. No shell reload and no process-wide kill.
set -euo pipefail
export NIDARA_SETTINGS_LEGACY=1
unset NIDARA_SETTINGS_EXECUTABLE
export NIDARA_SETTINGS_PROCESS=1 GDK_BACKEND=wayland
repo="${NIDARA_SETTINGS_REPO:-}"
marker="${XDG_CONFIG_HOME:-$HOME/.config}/nidara/.dev"
if [ -z "$repo" ] && [ -f "$marker" ]; then repo=$(cat "$marker"); fi
if [ -n "${NIDARA_SETTINGS_EXECUTABLE:-}" ]; then
    exec "$NIDARA_SETTINGS_EXECUTABLE" "$@"
elif [ -n "$repo" ] && [ -f "$repo/ui/settings/app.ts" ]; then
    export NIDARA_SHELL_ROOT="$repo/ui/shell" NIDARA_SETTINGS_ROOT="$repo/ui/settings"
    export NIDARA_KIT_DIR="$repo/ui/lib/nidara-kit"
    # Rebuilding everything cost ~580 ms on EVERY launch (measured 2026-10-17: sass 263,
    # host 161, bundle 94, kit 60) — more than half of what Settings itself takes to open.
    # Now only when something changed: a source newer than the stamp, or another commit.
    # Directories count too, so a deleted or renamed file is seen. Generated sheets are not
    # sources. NIDARA_SETTINGS_REBUILD=1 forces it.
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/nidara/dev-settings"
    out="$cache/nidara-settings.js" stamp="$cache/stamp"
    head=$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo none)
    if [ "${NIDARA_SETTINGS_REBUILD:-0}" = 1 ] || [ ! -f "$out" ] || [ ! -f "$stamp" ] \
        || [ "$(cat "$stamp")" != "$head" ] || [ ! -x "$repo/lib/nidara-host/build/nidara-settings" ] \
        || [ -n "$(find "$repo/ui" "$repo/scripts/bundle.mjs" "$repo/scripts/bundle.sh" "$repo/lib/nidara-host" \
            \( -name node_modules -o -name @girs -o -name build \) -prune \
            -o ! -name '*.css' ! -name '*.css.map' -newer "$stamp" -print -quit)" ]; then
        mkdir -p "$cache"
        # The stamp takes the time the build STARTS: an edit made during it is newer.
        echo "$head" > "$stamp.next"
        "$repo/ui/shell/node_modules/.bin/sass" --no-charset "$repo/ui/settings/style.scss" "$repo/ui/settings/style.css"
        node "$repo/scripts/bundle.mjs" kit "$repo/ui/lib/nidara-kit/build/js"
        # Written aside and moved in: a Settings already running keeps reading a whole file.
        next=$(mktemp "$cache/.nidara-settings.XXXXXX.js")
        "$repo/scripts/bundle.sh" --js "$repo/ui/settings/app.ts" "$next" --kit-external="$repo/ui/lib/nidara-kit/build/js"
        mv -f "$next" "$out"
        "$repo/lib/nidara-host/build.sh"
        mv -f "$stamp.next" "$stamp"
    fi
    LD_PRELOAD="${NIDARA_GTK4_LAYER_SHELL:-/usr/lib/libgtk4-layer-shell.so}" exec "$repo/lib/nidara-host/build/nidara-settings" "$out" "$@"
else
    export NIDARA_SHELL_ROOT=/usr/share/nidara/ui/shell NIDARA_SETTINGS_ROOT=/usr/share/nidara/ui/settings
    exec /usr/share/nidara/ui/settings/build/nidara-settings "$@"
fi
