[Unit]
Description=Nidara native dock (Hyalo preview)
Documentation=https://github.com/nidara-project/nidara-desktop
PartOf=graphical-session.target
Wants=nidara-sessiond.service
After=graphical-session.target nidara-sessiond.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/nidara-shell
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Slice=session-graphical.slice

# NOTE: no [Install]. Only /usr/lib/nidara-hyalo/start-shell starts it, and only with
# org.nidara.dock native-preview on — the TS shell then draws no dock (#959, until D4).
