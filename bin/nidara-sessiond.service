[Unit]
Description=Nidara session services (notifications, media and power)
Documentation=https://github.com/nidara-project/nidara-desktop
PartOf=graphical-session.target
After=graphical-session.target
Before=nidara.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.nidara.Session
# $NIDARA_SESSIOND_PREVIEW: unset (no word at all) unless the Hyalo preview's start-shell set it
# to --applications for the native dock (org.nidara.dock native-preview, #959 until D4).
ExecStart=/usr/bin/nidara-sessiond --media --power $NIDARA_SESSIOND_PREVIEW
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Slice=session-graphical.slice

# NOTE: intentionally NO [Install]/WantedBy=graphical-session.target, for the
# same reason as nidara.service: plain uwsm Hyprland reaches that generic target
# too. Only Nidara's compositor configs explicitly start us, before the shell.
# PartOf still stops us on logout. No org.freedesktop.Notifications activation
# file: that would start our notification server in somebody else's desktop.
