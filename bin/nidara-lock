#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# nidara-lock — Nidara lock screen launcher
# Installed to /usr/bin/nidara-lock
# Started by Hyalo (lock.rs: sleep, idle, `loginctl lock-session`, Super+L, and again when the
# lock client dies), which owns everything about the lock but the screen itself.
# The client is toolkit/lockscreen (#1195), installed to /usr/lib/nidara/nidara-lock.
# ─────────────────────────────────────────────────────────────────────────────

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nidara"
SYS_CLIENT="/usr/lib/nidara/nidara-lock"
# Per-user log path, like every other nidara-* log. NEVER a path the session
# user can't write (/var/log, another user's /tmp file): the `>> $LOG` redirect
# fails and bash then skips launching the client entirely, so the screen
# silently never locks (bit us 2026-07-03 with /var/log).
LOG="${XDG_RUNTIME_DIR:-/tmp}/nidara-lock.log"

# One lock client per SESSION: a lock on a file of this session's runtime directory and
# display, held (fd 9, inherited by the client through exec) for as long as it runs. Not
# `pgrep -x nidara-lock`, which saw every process of that name on the machine: a nested Hyalo's
# own lock client made the live session's launcher exit, and the live session stayed locked
# with no lock screen (2026-10-26). And two launches 10 ms apart (idle lock + sleep) each saw
# the other and BOTH left; a lock lets exactly one through.
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/nidara-lock.${WAYLAND_DISPLAY:-wayland}.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    exit 0
fi

# ── Dev mode: the client built in the source tree ───────────────────────────
CLIENT="$SYS_CLIENT"
DEV_FILE="$CONFIG_DIR/.dev"
if [ -f "$DEV_FILE" ]; then
    SOURCE_DIR="$(cat "$DEV_FILE")"
    for built in "$SOURCE_DIR/toolkit/target/release/nidara-lock" "$SOURCE_DIR/toolkit/target/debug/nidara-lock"; do
        if [ -x "$built" ]; then
            CLIENT="$built"
            break
        fi
    done
fi

if [ ! -x "$CLIENT" ]; then
    echo "[$(date '+%H:%M:%S')] nidara-lock: ERROR — client not found at $CLIENT" | tee -a "$LOG"
    exit 1
fi

# A client that dies leaves the session locked, and Hyalo starts this launcher again
# (lock.rs: RELAUNCH_LIMIT): no watchdog of our own.
exec "$CLIENT" >> "$LOG" 2>&1
