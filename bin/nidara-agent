#!/usr/bin/env -S gjs -m
// ─────────────────────────────────────────────────────────────────────────────
// nidara-agent — the brain of Nidara's built-in Assistant.
// Installed to /usr/bin/nidara-agent. NOT an MCP server and NOT invoked by the
// user directly: it is a long-running CHILD of the shell (spawned by
// core/AgentService.ts on first use) that speaks a tiny JSON-lines protocol over
// stdio — the inverse of nidara-mcp (there the shell is the client; here it is).
//
// WHAT IT DOES: turns natural language into desktop actions. Each user turn runs
// a streaming tool-use loop against a BYOK LLM (Anthropic Messages API, or any
// OpenAI-compatible endpoint incl. a local Ollama) and executes the model's tool
// calls by shelling out to `ags request` — the SAME official door the CLI and
// nidara-mcp use. So the assistant is just another client of the gated surface:
// Settings → AI gates (allowConfigWrite …) and the kill switch apply for free,
// and a new IPC action becomes usable with zero changes here (run_action is a
// passthrough — 100% coverage, like the MCP server).
//
// Plain GJS on purpose (same pattern as nidara-mcp / nidara-portal): no Node,
// no npm deps on installed systems. HTTP is `curl -N` streaming SSE as a
// subprocess — the house pattern (every HTTP call in the repo is curl), so this
// adds zero dependencies.
//
// CONFIG (re-read from ai.json EVERY turn, so changes take effect live):
//   brainBackend ("" | "anthropic" | "openai"), brainModel, brainEndpoint.
// The API KEY is never in ai.json — it lives in the DE keyring (libsecret,
// schema org.nidara.Assistant, attribute `backend`), written by Settings → AI.
//
// PROTOCOL (newline-delimited JSON):
//   shell→daemon: {t:"user",text} · {t:"cancel"} · {t:"reset"}
//   daemon→shell: {t:"state",s:"thinking"|"acting"|"idle"} · {t:"delta",text}
//                 {t:"tool",name,summary} · {t:"toolresult",ok,summary}
//                 {t:"done",usage:{input,output}} · {t:"error",message}
// ─────────────────────────────────────────────────────────────────────────────

import GLib from "gi://GLib"
import Gio from "gi://Gio"
import GioUnix from "gi://GioUnix"
import Secret from "gi://Secret"

const AI_JSON = `${GLib.get_user_config_dir()}/nidara/ai.json`
// Hard cap on tool-use round-trips per user turn. Was 8, sized for "open the
// control center" — one action and an answer. Reading files makes turns genuinely
// longer (find the file → read it → correlate with state → answer), and a turn
// that dies at the cap costs the user everything it already spent and delivers
// nothing. 16 covers a real diagnosis without becoming a budget to burn: this is
// still a desktop assistant, not a coding agent, and the repeated-failure guard
// below stops the pathological case long before the cap does.
const MAX_STEPS = 16
// Paging for read_file. The default is what a model gets when it doesn't think
// about it, so it has to be small enough that an unthinking read of a big file is
// survivable; the max is the escape hatch for when it does think.
const READ_LINES_DEFAULT = 400
const READ_LINES_MAX = 2000
const MAX_SEARCH_HITS = 100
// Ceiling on ANY tool result, applied after the tool runs. Tool results are the
// whales in the transcript — they land in `history` and ride in every later
// request of the conversation (measured 2026-07-22: one listApps was 85% of a
// 31 KB body) — and file reads are the first tool here able to produce hundreds of
// KB in a single call. Set above every current IPC result, so in practice this
// only ever bites a file read, and it tells the model how to narrow it.
const MAX_TOOL_RESULT = 24000
const HTTP_TIMEOUT = "120"     // curl --max-time (seconds)
const MAX_HTTP_ATTEMPTS = 3    // 1 try + up to 2 retries on a 5xx / network blip
const RETRY_BASE_MS = 600      // linear backoff between attempts: 600 ms, then 1200 ms
// Ceiling on an honoured `retry-after`. Past this the wait is worse than the
// truth: the island would sit "thinking" in silence for a minute with no way to
// tell a rate limit from a hang, so the provider's own message is shown instead.
const RETRY_AFTER_MAX_MS = 15000

// ── Telemetry ────────────────────────────────────────────────────────────────
// stderr is INHERITED from the shell, which nidara-ui appends to nidara-ui.log —
// so these lines land next to the shell's own, in order, for free.
//
// Rule learned the hard way (2026-07-21): a turn that fails must be
// reconstructible AFTER THE FACT. A user reporting "it did nothing" is useless
// without a trace, and the daemon's own death is exactly the case that can't
// report itself. So: lifecycle + turn boundaries + every HTTP leg + every tool.
// NEVER log the user's prompt or the model's reply (a desktop log is not the
// place for the conversation) — length and shape only. Never log the API key.
const log = (msg) => printerr(`[nidara-agent] ${msg}`)
const hostOf = (url) => { try { return url.replace(/^https?:\/\//, "").split("/")[0] } catch { return "?" } }

// ── Shell plumbing (shared shape with nidara-mcp) ────────────────────────────

function textFile(path) {
    const [ok, bytes] = GLib.file_get_contents(path)
    if (!ok) throw new Error(`cannot read ${path}`)
    return new TextDecoder().decode(bytes)
}

function readAiJson() {
    try {
        if (!GLib.file_test(AI_JSON, GLib.FileTest.EXISTS)) return {}
        return JSON.parse(textFile(AI_JSON))
    } catch {
        return {}
    }
}

// ── File frontier (tier 1) ───────────────────────────────────────────────────
// The assistant's file tools are DAEMON-LOCAL, not IPC actions: external MCP
// clients bring their own file tools, so there is nothing to mirror onto that
// surface, and routing file contents through the ags socket would put blocking
// I/O on the shell's main loop for no gain.
//
// Two frontiers, and they are deliberately NOT the same shape:
//
//   READ — prefix roots. Nidara's own domain: the user's desktop state, the
//   shipped defaults (so the assistant can see what it is overriding), and the
//   shell log (what turns it from a remote control into something that can
//   diagnose). Not the rest of $HOME: whatever it reads is sent to the model
//   provider, so the read frontier is a privacy boundary as much as a safety one.
//
//   WRITE — an EXACT allowlist of three files, because the write frontier grants
//   deferred execution and there is no way around that: hyprland-user.lua exists
//   to hold hl.exec_cmd(…) and hypridle.conf holds on-timeout commands, so
//   writing them schedules commands for the next session. That is inherent to
//   "add me a keybind", not a hole. What keeps it honest is that everything
//   scheduled is legible plain text, gated (allowFileWrite, default off) and
//   revertible — never an invisible action.
//
//   ~/.config/uwsm/env is READABLE and deliberately NOT WRITABLE: it sets the
//   session environment, so LD_PRELOAD there is straight privilege escalation,
//   and nothing a user asks an assistant for needs it.
//
// Every settings JSON is absent from the write list on purpose — the shell holds
// them in memory and rewrites them wholesale with no FileMonitor, so an outside
// edit is silently clobbered by the next settings change. set_config is the only
// correct door. See skills/customize/SKILL.md.
const HOME = GLib.get_home_dir()
const RUNTIME_DIR = GLib.getenv("XDG_RUNTIME_DIR") || "/tmp"

const READ_ROOTS = [
    `${HOME}/.config/nidara`,
    `${HOME}/.config/uwsm`,
    `${HOME}/.config/hypr`,
    "/usr/share/nidara",
]
// Single files outside those roots. The log path mirrors bin/nidara-ui's own
// `${XDG_RUNTIME_DIR:-/tmp}` fallback; both spellings are listed so the tool
// works whichever one the session actually used.
const READ_FILES = [`${RUNTIME_DIR}/nidara-ui.log`, "/tmp/nidara-ui.log"]

// The legacy ~/.config/hypr/hyprland-user.lua is included because pre-2026-07
// installs still load it (package.path lists ~/.config/nidara first and Lua
// require() takes the FIRST match, which is what Autostart.tsx's resolveUserConf
// mirrors) — editing the file Lua actually loads matters more than tidiness.
const WRITE_FILES = [
    `${HOME}/.config/nidara/hyprland-user.lua`,
    `${HOME}/.config/hypr/hyprland-user.lua`,
    `${HOME}/.config/nidara/hypridle.conf`,
]

const underRoot = (path, root) => path === root || path.startsWith(root + "/")

// Resolve a model-supplied path and decide whether it is inside the frontier.
// Returns { path } or { error } — the error text goes straight back to the model
// as the tool result, so it names what IS allowed rather than just refusing.
function resolvePath(raw, mode) {
    let p = String(raw ?? "").trim()
    if (!p) return { error: "No path given." }
    if (p === "~") p = HOME
    else if (p.startsWith("~/")) p = HOME + p.slice(1)
    if (!p.startsWith("/")) return { error: `Path must be absolute (or start with ~/): "${raw}"` }
    // Purely lexical: collapses "." and ".." without touching the filesystem, so
    // "~/.config/nidara/../../.ssh/id_rsa" is resolved BEFORE the prefix check
    // rather than sneaking past it.
    const path = GLib.canonicalize_filename(p, null)

    if (mode === "write") {
        if (!WRITE_FILES.includes(path)) return {
            error: `Not writable: ${path}. You may only write: ${WRITE_FILES.join(", ")}. `
                + "Settings live behind set_config — never edit a settings file directly, the shell overwrites it.",
        }
        // Symlinks are refused on the write side only. A symlink here would let a
        // path that passes the allowlist land somewhere else entirely, and the
        // allowlist is three known files that have no reason to be links. (Reads
        // do follow them: in a --dev install /usr/share/nidara/config/hypr/
        // hyprland.lua IS a symlink into the repo, and following it is correct.)
        try {
            const info = Gio.File.new_for_path(path).query_info(
                "standard::is-symlink", Gio.FileQueryInfoFlags.NOFOLLOW_SYMLINKS, null)
            if (info.get_is_symlink()) return { error: `Refusing to write through a symlink: ${path}` }
        } catch {
            // Does not exist yet — fine, creating it is allowed.
        }
        return { path }
    }

    if (READ_FILES.includes(path) || READ_ROOTS.some(r => underRoot(path, r))) return { path }
    return {
        error: `Not readable: ${path}. You may read ${READ_ROOTS.join(", ")} and the shell log `
            + `(${READ_FILES[0]}). Everything else is outside your frontier — say so rather than working around it.`,
    }
}

// Gate check, re-read per call like every other Nidara helper (nidara-a11y et al),
// so flipping the switch in Settings → AI takes effect on the next message.
function fileGate(mode) {
    const cfg = readAiJson()
    if (mode === "write") {
        if (cfg.allowFileWrite !== true) return "Editing files is turned off. The user can enable it in Settings → AI → Files."
        // Defence in depth: the shell keeps these consistent (setAllowFileWrite
        // implies read), but ai.json is a plain file anyone can hand-edit into an
        // inconsistent state, and "write without read" is exactly the combination
        // that corrupts a file instead of editing it.
        if (cfg.allowFileRead !== true) return "Editing files needs reading them first, which is turned off (Settings → AI → Files)."
        return null
    }
    if (cfg.allowFileRead !== true) return "Reading files is turned off. The user can enable it in Settings → AI → Files."
    return null
}

// ── Computer-use frontier (third-party apps) ─────────────────────────────────
// Perceiving and driving OTHER applications does not go through `ags request`
// either — it goes through the four standalone helpers the MCP server already
// uses (nidara-a11y / nidara-act / nidara-type / nidara-click). Same reasoning as
// the file layer, plus one that is specific to these: AT-SPI calls are synchronous
// D-Bus and can hang, which is exactly why they live in short-lived processes and
// not on the shell's main loop.
//
// The helpers own the enforcement — each re-reads ai.json, verifies the target is
// the focused window, plays the AI-cursor choreography and honours the kill switch
// mid-animation. So the assistant is the SAME kind of client here as MCP is, and
// gets all of that for free. What this file adds is the two things a conversation
// needs and a protocol adapter doesn't: tools shaped for a model with no eyes, and
// an honest `ok` flag (see helperResult).
//
// The gates decide what is OFFERED, not just what is refused — see buildToolset.
// A model told about a tool it cannot use promises the user something it cannot
// deliver, and pays for the schema on every step to do it.
function computerGate() {
    const cfg = readAiJson()
    const see = cfg.allowComputerUse === true
    return { see, act: see && cfg.allowComputerControl === true }
}

// The gate state the cached toolset + system prompt were built from. Both are
// built once per session; if the user grants or revokes permission mid-session,
// both have to be thrown away or the model keeps the picture it was given at
// spawn. Called at the turn boundary (see runTurn).
let builtGateSig = null
function syncComputerGate() {
    const g = computerGate()
    const sig = `${g.see}/${g.act}`
    if (sig === builtGateSig) return g
    if (builtGateSig !== null) {
        log(`computer-use gate changed (${builtGateSig} → ${sig}) — rebuilding toolset and system prompt`)
        systemCache = null
        toolsetCache = null
    }
    builtGateSig = sig
    return g
}

const GATE_SEE_OFF =
    "Seeing other apps is turned off. The user can enable it in Settings → AI → \"Allow Agents to See Other Apps\"."
const GATE_ACT_OFF =
    "Controlling other apps is turned off. The user can enable it in Settings → AI → \"Allow Agents to Control Other Apps\" (it needs seeing them too)."

// Dev-checkout pointer written by `install.sh --dev` (absent on system installs).
function devRepo() {
    try {
        const [ok, bytes] = GLib.file_get_contents(`${HOME}/.config/nidara/.dev`)
        if (ok) return new TextDecoder().decode(bytes).trim() || null
    } catch {}
    return null
}

// PATH first, dev checkout second — same order as nidara-mcp's findTool and as
// AgentService.resolveDaemon: a dev machine may not have re-run install.sh since
// a helper was added, and the repo copy is the one being worked on.
function findTool(name) {
    const inPath = GLib.find_program_in_path(name)
    if (inPath) return inPath
    const repo = devRepo()
    if (repo && GLib.file_test(`${repo}/bin/${name}`, GLib.FileTest.IS_EXECUTABLE))
        return `${repo}/bin/${name}`
    return null
}

// Run a command synchronously, capturing stdout+stderr. Used for the fast
// `ags request` calls (system-prompt build + tool execution); the slow leg (the
// LLM stream) is async curl so cancel still works mid-turn.
function run(argv) {
    const proc = Gio.Subprocess.new(
        argv,
        Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE,
    )
    const [, out, err] = proc.communicate_utf8(null, null)
    return { ok: proc.get_successful(), out: (out ?? "").trim(), err: (err ?? "").trim() }
}

// Delegates to the shell. Returns its output even on a non-zero exit, because a
// gate refusal (e.g. allowConfigWrite off) is a self-explanatory MESSAGE, not a
// crash — we hand it straight to the model as the tool result.
function agsRequest(args) {
    const r = run(["ags", "request", ...args])
    if (!r.ok && !r.out)
        throw new Error(`ags request failed (is the shell running?): ${r.err || "no output"}`)
    return r.out
}

// ── Keyring (fail-soft) ──────────────────────────────────────────────────────
// A Nidara session unlocks gnome-keyring at login (PAM). If the Secret Service
// is unavailable (or no key stored), lookup returns null and the backend proceeds
// keyless — fine for a local Ollama, surfaced as an auth error for Anthropic.
// Keyed by PROVIDER id (anthropic/openai/google/…), not by wire protocol: several
// providers share the openai-compatible protocol but each has its own key, so a
// protocol-keyed slot would make them collide. The shell owns the provider table
// (ui/shell/core/AgentProviders.ts) and writes the resolved backend/endpoint into
// ai.json — this daemon only needs the id to find the right key.
const KEY_SCHEMA = Secret.Schema.new(
    "org.nidara.Assistant",
    Secret.SchemaFlags.NONE,
    { provider: Secret.SchemaAttributeType.STRING },
)
function lookupKey(provider) {
    if (!provider) return null
    try {
        return Secret.password_lookup_sync(KEY_SCHEMA, { provider }, null)
    } catch {
        return null
    }
}

// ── stdio emitter + reader ───────────────────────────────────────────────────

const stdout = new Gio.DataOutputStream({
    base_stream: new GioUnix.OutputStream({ fd: 1, close_fd: false }),
})
function emit(obj) {
    stdout.put_string(JSON.stringify(obj) + "\n", null)
    stdout.flush(null)
}
const emitError = (m) => emit({ t: "error", message: String(m) })
// Count deltas so a failed request can only be retried BEFORE any text has been
// shown — a retry after that would double-render the reply. Monotonic across the
// session; the retry loop only compares before/after within a single attempt.
let deltasEmitted = 0
const emitDelta = (text) => { if (text) { deltasEmitted++; emit({ t: "delta", text }) } }

// ── Skills ───────────────────────────────────────────────────────────────────
// Markdown playbooks the assistant loads ON DEMAND. Progressive disclosure is the
// whole point and not a refinement: the in-repo `nidara` skill is ~100k tokens
// across its references, which is correct for a developer's agent and unusable
// here, where every token rides on every step of every turn. So the tool
// description carries only names + one-line descriptions (~30 tokens today) and
// the body is fetched when the model decides it needs it.
//
// Same resolution order as Paths.ts/readShellVersion: a --dev checkout wins over
// the installed copy, so editing a skill in the repo takes effect without an
// install.
function skillsDir() {
    const repo = devRepo()
    if (repo && GLib.file_test(`${repo}/skills`, GLib.FileTest.IS_DIR)) return `${repo}/skills`
    return "/usr/share/nidara/skills"
}

// Split YAML-ish frontmatter from the body. Deliberately not a YAML parser: the
// contract is two flat `key: value` lines, and a skill that gets fancier than
// that should be simplified rather than met with a parser.
function parseSkill(text) {
    const m = /^---\n([\s\S]*?)\n---\n?/.exec(text)
    if (!m) return { meta: {}, body: text }
    const meta = {}
    for (const line of m[1].split("\n")) {
        const kv = /^(\w+):\s*(.*)$/.exec(line)
        if (kv) meta[kv[1]] = kv[2].trim()
    }
    return { meta, body: text.slice(m[0].length).trim() }
}

let skillsCache = null   // { name: { path, description } }
function skills() {
    if (skillsCache) return skillsCache
    skillsCache = {}
    const dir = skillsDir()
    try {
        const en = Gio.File.new_for_path(dir).enumerate_children(
            "standard::name,standard::type", Gio.FileQueryInfoFlags.NONE, null)
        for (;;) {
            const info = en.next_file(null)
            if (!info) break
            if (info.get_file_type() !== Gio.FileType.DIRECTORY) continue
            const name = info.get_name()
            const path = `${dir}/${name}/SKILL.md`
            if (!GLib.file_test(path, GLib.FileTest.EXISTS)) continue
            let description = ""
            try {
                const { meta } = parseSkill(textFile(path))
                description = meta.description || ""
            } catch {}
            skillsCache[name] = { path, description }
        }
        en.close(null)
    } catch (e) {
        log(`skills: none available (${dir}: ${e?.message ?? e})`)
    }
    return skillsCache
}

function loadSkillTool(name) {
    const all = skills()
    const hit = all[String(name ?? "").trim()]
    if (!hit) return {
        ok: false,
        content: `No skill called "${name}". Available: ${Object.keys(all).join(", ") || "(none)"}.`,
    }
    try {
        return { ok: true, content: parseSkill(textFile(hit.path)).body }
    } catch (e) {
        return { ok: false, content: `Could not load skill "${name}": ${e?.message ?? e}` }
    }
}

// ── Tools offered to the model ───────────────────────────────────────────────
// ONE passthrough tool (run_action) whose DESCRIPTION carries an index of every
// desktop action — name + one-clause summary — instead of 32 first-class tool
// schemas. Generated from `ags request listActions`, so a new action still appears
// for free (the self-maintaining property), and it weighs ~450 tokens where the 32
// JSON schemas weighed ~2000 — a block that is re-sent on EVERY step of EVERY turn,
// so every byte is paid per request (measured 2026-07-23).
//
// This keeps BOTH properties the first-class tools were adopted for, at ~¼ the cost:
//   1. NO DISCOVERY ROUND-TRIP. Names + summaries sit in front of the model at all
//      times (in run_action's description), so it never spends a request on a
//      list_actions lookup before acting. The earlier run_action design paid that
//      round-trip because the names lived BEHIND a lookup; moving them into the
//      description removes it. A text index — not 32 schemas — is all that took.
//   2. NO INVENTED NAMES. The index lists snake_case names, run_action takes a
//      snake_case `action`, and execTool maps it back (camelCase accepted too).
//
// SETTINGS stay dedicated tools (set_config/get_config/dump_state/describe_settings):
// structured args plus a discipline (describe_settings before guessing a key) that a
// passthrough would blur, and describe_settings still gates its 4 KB schema on demand.
// run_action resolves ONLY the visible actions — the config door is those dedicated
// tools, and shell-internal plumbing stays unreachable by the model.
const STATIC_TOOL_DEFS = [
