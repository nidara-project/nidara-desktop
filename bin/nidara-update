#!/bin/bash
# ─────────────────────────────────────────────────────────────────────────────
# nidara-update — update an installed Nidara. Installed to /usr/bin/nidara-update.
#
# Two paths, and a message for the case that is neither:
#   DEV     — if a dev install registered its own clone (~/.config/nidara/.dev,
#             written by `install.sh --dev`), update from THERE, following the dev
#             branch. Hands over to that clone's install.sh so the updater itself
#             updates with the repo.
#   PACKAGE — the desktop is installed as the pacman package `nidara-desktop`
#             (`nidara` before the 2026-08-30 rename; both are handled): new
#             releases arrive through the [nidara] repo on a plain full upgrade,
#             pacman owns files and deps, no git involved. nidara-setup then
#             re-applies the idempotent system/user setup (new config seeds,
#             greetd refresh, new services).
#
# ⚠️ There used to be a THIRD, "STABLE (script-era)": clone the newest release tag
# into a temp dir and install from there, migrating a pre-package install to the
# package on the way. It is gone with install.sh's system path (2026-09-02,
# nidara-iso PRODUCT.md → step 3). Migrating IS installing the package now, so
# that branch prints the three commands instead of being a second implementation
# of them. Nothing else in this file used the clone, which is why REPO_URL left
# with it.
# ─────────────────────────────────────────────────────────────────────────────
set -e
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nidara"

# ── DEV path: update from the developer's own registered clone ─────────────────
if [ -f "$CONFIG_DIR/.dev" ]; then
    DEV_SRC="$(cat "$CONFIG_DIR/.dev" 2>/dev/null)"
    if [ -n "$DEV_SRC" ] && [ -f "$DEV_SRC/install.sh" ]; then
        exec bash "$DEV_SRC/install.sh" --update
    fi
    echo "nidara-update: dev marker present but '$DEV_SRC' has no install.sh." >&2
    echo "Re-run ./install.sh --dev from your clone to re-register it." >&2
    exit 1
fi

# ── Carried local patches: refuse to blindly reinstall over them ──────────────
# An agent that keeps a local (not-contributed) repo fix for this user records
# the clone carrying it in .patches — see the in-repo nidara skill,
# references/agent-contribution.md ("Carrying a GLOBAL fix locally"). The
# stateless update below installs pure upstream, which would silently stop
# applying those patches.
if [ -f "$CONFIG_DIR/.patches" ]; then
    PATCH_SRC="$(cat "$CONFIG_DIR/.patches" 2>/dev/null)"
    echo "nidara-update: this install carries local patches (clone: ${PATCH_SRC:-unknown})." >&2
    echo "A plain update would reinstall pure upstream and silently drop them." >&2
    echo "Ask your agent to update instead — it rebases the patches onto the new release" >&2
    echo "and reinstalls (procedure in the repo's nidara skill). To discard the patches" >&2
    echo "and return to pure upstream:" >&2
    echo "    rm ~/.config/nidara/.patches && nidara-update" >&2
    exit 1
fi

# ── PACKAGE path: installed via pacman → update via pacman ───────────────────
# NOTE this must stay AFTER the .patches guard: a patched install is a locally
# built package, and a blind -Syu would replace it with pure upstream the
# moment the repo serves a newer release — silently dropping the patches.
# ⚠️ The package was renamed `nidara` → `nidara-desktop` on 2026-08-30, and the
# upgrade below is the very thing that performs the rename on a machine that has
# not taken it yet: `old_v` is read BEFORE it, possibly under the old name, and
# `new_v` AFTER, necessarily under the new one. So both reads ask "whichever of
# the two is installed" instead of naming one. A version read from a name pacman
# has just retired comes back EMPTY and does not fail — it would make the
# comparison below announce a change that did not happen, or miss one that did.
_installed_desktop_pkg() {
    for _p in nidara-desktop nidara; do
        if pacman -Qq "$_p" >/dev/null 2>&1; then printf '%s\n' "$_p"; return 0; fi
    done
    return 1
}

if _pkg="$(_installed_desktop_pkg)"; then
    old_v="$(pacman -Q "$_pkg" | awk '{print $2}')"
    echo "nidara-update: the desktop is pacman-managed ($_pkg $old_v) — running a full system upgrade…"
    # Interactive on purpose (no --noconfirm): this is a FULL system upgrade,
    # the user should see what it pulls in. Declining aborts the update.
    sudo pacman -Syu
    # Re-resolve: the upgrade may have changed the package's NAME under us.
    _pkg="$(_installed_desktop_pkg)" || { echo "nidara-update: the desktop package is gone after the upgrade — aborting." >&2; exit 1; }
    new_v="$(pacman -Q "$_pkg" | awk '{print $2}')"
    nidara-setup
    if [ "$old_v" = "$new_v" ]; then
        echo "nidara-update: already up to date ($_pkg $new_v)."
    else
        echo "nidara-update: $_pkg $old_v → $new_v."
        # Reload the running shell so the new bundle takes effect now; greeter
        # and lockscreen pick theirs up on next use.
        if systemctl --user is-active --quiet nidara.service 2>/dev/null; then
            systemctl --user restart nidara.service || true
            echo "nidara-update: shell reloaded."
        fi
        # The upgrade replaced /usr/share/nidara/config/hypr/hyprland.lua under
        # the live compositor: Hyprland's config watch fires mid-extract, errors
        # "cannot open … hyprland.lua", and the banner sticks — the watch died
        # with the old inode, so it never sees the new file land. Reload now
        # that it's in place. No-op outside a Hyprland session.
        if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
            hyprctl reload >/dev/null 2>&1 || true
        fi
        # The user's own scripts for this event, if any (see bin/nidara-hook).
        # LAST, and only when the version actually moved: hooks are synchronous
        # and each may take its full timeout, so firing them earlier would hold
        # the shell reload behind somebody's script.
        nidara-hook update-completed "$old_v" "$new_v" || true
    fi
    exit 0
fi

# ── No package, no dev clone: an install from before the package model ───────
# There is nothing left here to drive such an update. `install.sh` lost its system
# path on 2026-09-02 (nidara-iso PRODUCT.md, "What does NOT change" → step 3), so
# the stateless clone-and-install this branch used to do has no implementation and
# no reason to have one: migrating to the package IS the three commands below, and
# they are the same ones a first-time install runs.
#
# Judged safe to drop rather than reimplement: the package model landed in August
# 2026 and pre-package installs are not believed to exist in the wild. If one
# does, it is not broken by this — it is told exactly what to run, which is more
# than the old path explained while it was doing it.
echo "nidara-update: this install predates the package model — there is no package" >&2
echo "               and no registered dev clone to update from." >&2
echo "" >&2
echo "Install the package once; every later update is then 'nidara-update' or a" >&2
echo "plain 'pacman -Syu', and pacman owns the files:" >&2
echo "" >&2
echo "    curl -O https://nidara-project.github.io/nidara-repo/nidara.gpg" >&2
echo "    sudo pacman-key --add nidara.gpg" >&2
echo "    sudo pacman-key --lsign-key 80B0AC8C36A43611A8619959B06B716279F755A9" >&2
echo "" >&2
echo "    # then add to /etc/pacman.conf:" >&2
echo "    #   [nidara]" >&2
echo "    #   SigLevel = Required DatabaseOptional" >&2
echo "    #   Server = https://nidara-project.github.io/nidara-repo/\$arch" >&2
echo "" >&2
echo "    sudo pacman -Syu nidara-desktop && nidara-setup" >&2
echo "" >&2
echo "The files this install wrote into /usr are handed over by that upgrade." >&2
echo "Your configuration in ~/.config/nidara/ is not touched." >&2
exit 1
