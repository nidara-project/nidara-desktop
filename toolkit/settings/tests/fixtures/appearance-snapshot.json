  "appearance.windowBackground": {
   "desc": "Nidara's own windows (Settings, About, the installer and toolkit apps that follow the setting): opaque; tinted â the colour of what is behind comes through, heavily blurred, subtle; or translucent â less opaque and less blurred, what is behind shows. A window that lets anything through is always blurred. Separate from the interface's glass. Ignored (opaque) while accessibility.reduceTransparency is on. Other apps' translucent windows always get the translucent blur.",
   "type": "enum",
   "values": [
    "opaque",
    "tinted",
    "translucent"
   ],
   "writable": true,
   "value": "tinted",
   "page": "appearance",
   "group": "settings.appearance.group.windows",
   "available": true,
   "ui": {
    "i18n": "settings.appearance.window-background",
    "title": "Window style",
    "subtitle": "Tinted lets the colour of what is behind come through, heavily blurred; translucent shows more of it.",
    "control": "segmented",
    "options": [
     {
      "value": "opaque",
      "label": "Opaque"
     },
     {
      "value": "tinted",
      "label": "Tinted"
     },
     {
      "value": "translucent",
      "label": "Translucent"
     }
    ]
   }
  },
  "appearance.windowControls": {
   "desc": "Which side of a window its controls (close, maximize; minimize where the compositor minimizes) go on: right, the Linux and Windows convention (close last), or left (close first; in a window with a sidebar shown, inside it). For every window: the compositor's controls over Nidara's windows and its title bar, and the buttons of apps that draw their own title bar (GTK, Chrome's web apps, Telegram) â all read org.gnome.desktop.wm.preferences button-layout, which this writes.",
   "type": "enum",
   "values": [
    "right",
    "left"
   ],
   "writable": true,
   "value": "right",
   "page": "appearance",
   "group": "settings.appearance.group.windows",
   "available": true,
   "ui": {
    "i18n": "settings.appearance.window-controls",
    "title": "Window buttons",
    "subtitle": "Close, minimize and maximize: the side of the window they go on.",
    "control": "segmented",
    "options": [
     {
      "value": "right",
      "label": "Right"
     },
     {
      "value": "left",
      "label": "Left"
     }
    ]
   }
  },
