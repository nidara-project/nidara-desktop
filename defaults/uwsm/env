# Nidara — uwsm environment variables
# Loaded by uwsm before any session service starts.
# Format: export KEY=VALUE
# Reference: https://wiki.hyprland.org/Configuring/Environment-variables/

# Wayland backends
export GDK_BACKEND=wayland,x11
# Quote the value: this file is SOURCED as shell by uwsm, so a bare ';' would end
# the export and run 'xcb' as a command (truncating the var to just 'wayland').
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland

# Application Wayland hints
export MOZ_ENABLE_WAYLAND=1
export OZONE_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# Qt theming — `xdgdesktopportal`. Medido, no elegido por descarte.
# Qt no lee NADA del settings.ini de GTK por su cuenta (0 coincidencias de
# gtk-icon-theme-name / gtk-font-name / gtk-application-prefer-dark-theme en
# libQt6Gui), así que todo lo que una app Qt sabe de este escritorio llega por su
# plugin de tema de plataforma. Los dos candidatos, con lo que cuesta cada uno:
#
#   · xdgdesktopportal → el esquema de color por D-Bus y, sobre todo, el DIÁLOGO DE
#     ARCHIVOS del portal: fuera del proceso, compatible con sandbox, sin meter GTK3
#     dentro de cada app Qt. No entrega tema de iconos (Telegram resuelve `hicolor`).
#   · gtk3            → entrega iconos y fuente desde GtkSettings, pero instancia un
#     GtkFileChooserDialog DENTRO del proceso Qt y carga libgtk-3/Cairo/Pango en
#     todas ellas. Se probó el 2026-09-20 y se revirtió: el diálogo del portal pesa
#     más que el tema de iconos.
#
# ⚠️ Coste asumido a sabiendas, y MEDIDO el 2026-09-21 con una sonda propia
# (QGuiApplication → QIcon::themeName, control positivo: el mismo binario responde
# distinto según el plugin, así que mide de verdad):
#
#              xdgdesktopportal        gtk3
#   iconos     hicolor                 Papirus
#   folder     hasThemeIcon() = 0      = 1
#   fuente     Sans Serif 9            Inter Variable 11
#
# No es «caen a hicolor»: es que NO HAY ICONO, ni siquiera `folder`, y además se
# pierde la fuente. El resto del intercambio, medido el mismo día: `colorSchemeChanged`
# llega con los DOS plugins y `palette()` no se invalida con NINGUNO (empate), el
# diálogo del portal sale de otro proceso y el de gtk3 se dibuja dentro de la app Qt
# (`class` de la propia app, con libgtk-3 mapeado en ella: 5 mapeos contra 0). El
# dueño mantuvo el portal con esa foto delante.
#
# 🔴 NO re-proponer `~/.icons/default`: esta nota decía que esa era la salida correcta
# y es FALSA. Medido con control positivo — un `index.theme` con `Inherits=Papirus`
# ahí deja a Qt en `hicolor` igual, con y sin él (plantando un folder.svg en el
# `hicolor` de ese mismo HOME, `hasThemeIcon` sí salta a 1, así que la sonda leía el
# HOME). Y ese fichero ya está ocupado: `AppearanceSync.writeXcursorDefault()` lo
# escribe con el tema de CURSOR, así que la vía además chocaba con él.
# Lo que queda sin explorar es `qt6ct` o un baseTheme de Qt que lea gsettings.
# Debe coincidir con bin/nidara; uwsm sourcea este fichero DESPUÉS de los exports del
# lanzador, así que este valor es el que gana.
export QT_QPA_PLATFORMTHEME=xdgdesktopportal

