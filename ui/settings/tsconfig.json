{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "module": "ES2022",
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "lib": [
      "ES2020",
      "ES2021.Intl",
      "DOM"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "../shell/gi.d.ts",
    "../shell/gi-types.d.ts",
    "../shell/global.d.ts",
    "../shell/env.d.ts",
    "../lib/nidara-kit/gi-cairo.d.ts",
    "**/*.ts",
    "../shell/@girs/**/*"
  ],
  "exclude": [
    "build"
  ]
}
